diff --git a/plugin/QuickPresets.lua b/plugin/QuickPresets.lua
index c472420..40b37fb 100644
--- a/plugin/QuickPresets.lua
+++ b/plugin/QuickPresets.lua
@@ -327,6 +327,27 @@ local function ApplyAndSyncPreset(mapName, preset)
     return false
 end
 
+-- Key bindings 1-10 directly apply the matching saved preset for the
+-- player's current map. They reuse the existing ApplyAndSyncPreset path, so
+-- leader/assistant permission checks and CLEAR/PLACE/M1 synchronization stay
+-- identical to clicking the manager's Apply button. No window is opened.
+function MoonMarker_BindingApplyQuickPreset(slot)
+    slot = tonumber(slot)
+    if not slot then return false end
+    slot = math.floor(slot)
+    if slot < 1 or slot > 10 then return false end
+
+    local mapName = CurrentMapName()
+    local group = GetMapGroup(mapName, false)
+    local preset = group and group.presets and group.presets[slot]
+    if not preset then
+        SetStatus("当前地图没有第 " .. tostring(slot) .. " 组队伍光柱配置。", true)
+        return false
+    end
+
+    return ApplyAndSyncPreset(mapName, preset)
+end
+
 local function SaveCurrentPreset()
     local mapName = CurrentManagerMap()
     local presetName = QP.nameEdit and Trim(QP.nameEdit:GetText()) or ""
