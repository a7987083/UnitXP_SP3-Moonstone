+int pushIconProjection(void* L) {
+    if (L == nullptr || !moonMarkerRuntimeGuard::enabled()) return 0;
+
+    const RECT client = vanilla1121_gameClientRect();
+    const double width = static_cast<double>(client.right - client.left);
+    const double height = static_cast<double>(client.bottom - client.top);
+
+    lua_newtable(L);
+    setLuaNumber(L, "clientWidth", width);
+    setLuaNumber(L, "clientHeight", height);
+    if (width <= 1.0 || height <= 1.0) return 1;
+
+    for (std::size_t i = 0; i < gProjected.size(); ++i) {
+        const ProjectedIcon& projected = gProjected[i];
+        if (!projected.visible || projected.iconIndex < 0
+            || projected.iconIndex >= static_cast<int>(kIconCount)) {
+            continue;
+        }
+
+        lua_pushstring(L, kColors[i].name);
+        lua_newtable(L);
+        setLuaNumber(L, "x", projected.x);
+        setLuaNumber(L, "y", projected.y);
+        setLuaNumber(L, "size", projected.size);
+        setLuaNumber(L, "xNorm", static_cast<double>(projected.x) / width);
+        setLuaNumber(L, "yNorm", static_cast<double>(projected.y) / height);
+        setLuaNumber(L, "sizeNorm", static_cast<double>(projected.size) / height);
+        setLuaNumber(L, "iconIndex", projected.iconIndex + 1);
+        setLuaString(L, "icon", kIconNames[static_cast<std::size_t>(projected.iconIndex)]);
+        lua_settable(L, -3);
+    }
+    return 1;
+}
