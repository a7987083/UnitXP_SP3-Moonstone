index 0000000..2b1c64e
--- /dev/null
+++ b/plugin/SystemRaidIcons.lua
@@ -0,0 +1,138 @@
+-- Blizzard original raid-target icons above Hotkeys10 native M2 beams.
+-- Native Hotkeys10 remains responsible for beam creation, color, world position,
+-- projection and synchronization. Lua only draws the untouched system atlas.
+
+local PROJECTION_COMMAND = "MoonMarker.IconProjection"
+local SYSTEM_TEXTURE = "Interface\\TargetingFrame\\UI-RaidTargetingIcons"
+local UPDATE_INTERVAL = 0.03
+local MIN_SIZE = 24
+local MAX_SIZE = 72
+
+local colors = MoonMarkerShared and MoonMarkerShared.colors or {}
+local frames = {}
+local elapsed = 0
+
+local function HideAll()
+    for _, iconFrame in pairs(frames) do
+        iconFrame:Hide()
+    end
+end
+
+local function CreateIconFrame(colorKey)
+    local iconFrame = CreateFrame("Frame", "MoonMarkerSystemRaidIcon_" .. colorKey, UIParent)
+    iconFrame:SetWidth(42)
+    iconFrame:SetHeight(42)
+    iconFrame:SetFrameStrata("TOOLTIP")
+    iconFrame:EnableMouse(false)
+
+    local texture = iconFrame:CreateTexture(nil, "OVERLAY")
+    texture:SetAllPoints(iconFrame)
+    texture:SetTexture(SYSTEM_TEXTURE)
+    texture:SetVertexColor(1, 1, 1, 1)
+
+    iconFrame.texture = texture
+    iconFrame.iconIndex = 0
+    iconFrame.lastSize = 0
+    iconFrame:Hide()
+    frames[colorKey] = iconFrame
+    return iconFrame
+end
+
+local function ValidNumber(value)
+    value = tonumber(value)
+    if not value then return nil end
+    if value ~= value then return nil end
+    return value
+end
+
+local function UpdateIcons()
+    if type(UnitXP) ~= "function" or type(SetRaidTargetIconTexture) ~= "function" then
+        HideAll()
+        return
+    end
+
+    local ok, projection = pcall(UnitXP, PROJECTION_COMMAND)
+    if not ok or type(projection) ~= "table" then
+        HideAll()
+        return
+    end
+
+    local uiWidth = UIParent:GetWidth()
+    local uiHeight = UIParent:GetHeight()
+    local clientWidth = ValidNumber(projection.clientWidth)
+    local clientHeight = ValidNumber(projection.clientHeight)
+    if not uiWidth or not uiHeight or uiWidth <= 1 or uiHeight <= 1
+        or not clientWidth or not clientHeight or clientWidth <= 1 or clientHeight <= 1 then
+        HideAll()
+        return
+    end
+
+    for _, colorInfo in ipairs(colors) do
+        local colorKey = colorInfo.key
+        local point = projection[colorKey]
+        local iconFrame = frames[colorKey]
+        local shown = false
+
+        if type(point) == "table" then
+            local iconIndex = ValidNumber(point.iconIndex)
+            local xNorm = ValidNumber(point.xNorm)
+            local yNorm = ValidNumber(point.yNorm)
+            local sizeNorm = ValidNumber(point.sizeNorm)
+
+            -- Compatibility fallback for a DLL that returns physical pixels.
+            if not xNorm then
+                local x = ValidNumber(point.x)
+                if x then xNorm = x / clientWidth end
+            end
+            if not yNorm then
+                local y = ValidNumber(point.y)
+                if y then yNorm = y / clientHeight end
+            end
+            if not sizeNorm then
+                local size = ValidNumber(point.size)
+                if size then sizeNorm = size / clientHeight end
+            end
+
+            if iconIndex and iconIndex >= 1 and iconIndex <= 8
+                and xNorm and yNorm and sizeNorm
+                and xNorm >= 0 and xNorm <= 1 and yNorm >= 0 and yNorm <= 1 then
+                if not iconFrame then iconFrame = CreateIconFrame(colorKey) end
+                if iconFrame.iconIndex ~= iconIndex then
+                    iconFrame.texture:SetTexture(SYSTEM_TEXTURE)
+                    SetRaidTargetIconTexture(iconFrame.texture, iconIndex)
+                    iconFrame.iconIndex = iconIndex
+                end
+
+                local size = sizeNorm * uiHeight
+                if size < MIN_SIZE then size = MIN_SIZE end
+                if size > MAX_SIZE then size = MAX_SIZE end
+                if math.abs((iconFrame.lastSize or 0) - size) > 0.1 then
+                    iconFrame:SetWidth(size)
+                    iconFrame:SetHeight(size)
+                    iconFrame.lastSize = size
+                end
+
+                iconFrame:ClearAllPoints()
+                iconFrame:SetPoint("CENTER", UIParent, "BOTTOMLEFT",
+                    xNorm * uiWidth, (1 - yNorm) * uiHeight)
+                iconFrame:Show()
+                shown = true
+            end
+        end
+
+        if iconFrame and not shown then iconFrame:Hide() end
+    end
+end
+
+local driver = CreateFrame("Frame", "MoonMarkerSystemRaidIconDriver", UIParent)
+driver:SetScript("OnUpdate", function()
+    elapsed = elapsed + (arg1 or 0)
+    if elapsed < UPDATE_INTERVAL then return end
+    elapsed = 0
+    UpdateIcons()
+end)
+driver:RegisterEvent("PLAYER_LEAVING_WORLD")
+driver:RegisterEvent("PLAYER_ENTERING_WORLD")
+driver:SetScript("OnEvent", function()
+    HideAll()
+end)
