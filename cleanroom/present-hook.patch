+}
+
+bool writePresentSlot(void** slot, void* value) {
+    if (slot == nullptr) return false;
+    DWORD oldProtection = 0;
+    if (!VirtualProtect(slot, sizeof(void*), PAGE_EXECUTE_READWRITE, &oldProtection)) return false;
+    InterlockedExchangePointer(reinterpret_cast<PVOID volatile*>(slot), value);
+    DWORD ignoredProtection = 0;
+    VirtualProtect(slot, sizeof(void*), oldProtection, &ignoredProtection);
+    FlushInstructionCache(GetCurrentProcess(), slot, sizeof(void*));
+    return true;
+}
+
+} // namespace
