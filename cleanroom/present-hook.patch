+    if (!writePresentSlot(presentSlot, reinterpret_cast<void*>(&hookedPresent))) {
+        gOriginalPresent = nullptr;
+        gPresentVtableSlot = nullptr;
+        gPresentHookInstalled = false;
+        return false;
+    }
+    gPresentHookInstalled = true;
+    gLastPresentDevice = device;
+    ensureTexture(device);
+    return true;
+}
