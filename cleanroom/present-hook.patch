+bool installPresentHook(IDirect3DDevice9* device) {
+    if (device == nullptr) return false;
+    void*** object = reinterpret_cast<void***>(device);
+    if (object == nullptr || *object == nullptr) return false;
+
+    void** presentSlot = &(*object)[17];
+    if (gPresentHookInstalled && gPresentVtableSlot == presentSlot
+        && *presentSlot == reinterpret_cast<void*>(&hookedPresent)) {
+        ensureTexture(device);
+        return true;
+    }
+
+    if (gPresentHookInstalled && gPresentVtableSlot != nullptr
+        && gOriginalPresent != nullptr
+        && *gPresentVtableSlot == reinterpret_cast<void*>(&hookedPresent)) {
+        writePresentSlot(gPresentVtableSlot, reinterpret_cast<void*>(gOriginalPresent));
+    }
+
+    PresentProc candidate = reinterpret_cast<PresentProc>(*presentSlot);
+    if (candidate == nullptr || candidate == &hookedPresent) return false;
+    gOriginalPresent = candidate;
