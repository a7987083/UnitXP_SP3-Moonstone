diff --git a/addon_base/MoonMarker/MoonMarker.lua b/addon_new/MoonMarker/MoonMarker.lua
index 04de02e..7730702 100644
--- a/addon_base/MoonMarker/MoonMarker.lua
+++ b/addon_new/MoonMarker/MoonMarker.lua
@@ -13,6 +13,24 @@ local colors = {
     { key = "white",  label = "白", r = 0.86, g = 0.92, b = 1.00 },
 }
 
+local MODEL_PATH = "Spells\\MoonBeam_Impact_Base.mdx"
+local modelFrames = {}
+local modelElapsed = 0
+local MODEL_UPDATE_INTERVAL = 0.015
+
+local modelDefaults = {
+    enabled = true,
+    size = 620,
+    offsetX = 0,
+    offsetY = 0,
+    scale = 1.00,
+    positionX = 0.00,
+    positionY = 0.00,
+    positionZ = 0.00,
+    facing = 0.00,
+    sequence = 0,
+}
+
 local function Print(message)
     DEFAULT_CHAT_FRAME:AddMessage("|cff91cfff[MoonMarker]|r " .. tostring(message))
 end
@@ -94,9 +112,227 @@ local function Status()
         Print("状态查询失败：" .. tostring(count))
         return
     end
-    Print(string.format("记录=%s，Present钩子=%s，渲染帧=%s，当前投影=%s，纹理=%s",
-        tostring(count), hook and "已安装" or "未安装", tostring(draws), tostring(projected),
-        texture and "已加载" or "未加载"))
+    local visibleModels = 0
+    for _, model in pairs(modelFrames) do
+        if model:IsShown() then visibleModels = visibleModels + 1 end
+    end
+    Print(string.format("记录=%s，当前投影=%s，M2模型=%s，显示模型=%s，纹理近似=%s",
+        tostring(count), tostring(projected),
+        MoonMarkerDB.modelEnabled == false and "关闭" or "开启",
+        tostring(visibleModels), texture and "已加载" or "停用"))
+end
+
+local function ApplyModelSettings(model)
+    local size = tonumber(MoonMarkerDB.modelSize) or modelDefaults.size
+    model:SetWidth(size)
+    model:SetHeight(size)
+    pcall(function() model:SetModelScale(tonumber(MoonMarkerDB.modelScale) or modelDefaults.scale) end)
+    pcall(function()
+        model:SetPosition(
+            tonumber(MoonMarkerDB.modelPositionX) or modelDefaults.positionX,
+            tonumber(MoonMarkerDB.modelPositionY) or modelDefaults.positionY,
+            tonumber(MoonMarkerDB.modelPositionZ) or modelDefaults.positionZ)
+    end)
+    pcall(function() model:SetFacing(tonumber(MoonMarkerDB.modelFacing) or modelDefaults.facing) end)
+    pcall(function() model:SetSequence(tonumber(MoonMarkerDB.modelSequence) or modelDefaults.sequence) end)
+end
+
+local function CreateWorldModel(color)
+    local model = CreateFrame("PlayerModel", "MoonMarkerWorldModel_" .. color, UIParent)
+    model:SetFrameStrata("BACKGROUND")
+    model:SetFrameLevel(1)
+    model:EnableMouse(false)
+    pcall(function() model:SetModel(MODEL_PATH) end)
+    ApplyModelSettings(model)
+    model:Hide()
+    modelFrames[color] = model
+    return model
+end
+
+local function GetWorldModel(color)
+    return modelFrames[color] or CreateWorldModel(color)
+end
+
+local function HideWorldModels()
+    for _, model in pairs(modelFrames) do
+        model:Hide()
+    end
+end
+
+local function ReloadWorldModels()
+    for _, model in pairs(modelFrames) do
+        pcall(function() model:ClearModel() end)
+        pcall(function() model:SetModel(MODEL_PATH) end)
+        ApplyModelSettings(model)
+    end
+end
+
+local function UpdateWorldModels()
+    if MoonMarkerDB.modelEnabled == false or not HasDLL() then
+        HideWorldModels()
+        return
+    end
+
+    local ok, count, marks = pcall(UnitXP, "MoonMarker.Projected")
+    if not ok or type(marks) ~= "table" then
+        HideWorldModels()
+        return
+    end
+
+    local uiWidth = UIParent:GetWidth()
+    local uiHeight = UIParent:GetHeight()
+    if not uiWidth or not uiHeight or uiWidth <= 0 or uiHeight <= 0 then
+        HideWorldModels()
+        return
+    end
+
+    local shown = {}
+    local offsetX = tonumber(MoonMarkerDB.modelOffsetX) or modelDefaults.offsetX
+    local offsetY = tonumber(MoonMarkerDB.modelOffsetY) or modelDefaults.offsetY
+
+    for i = 1, tonumber(count) or 0 do
+        local mark = marks[i]
+        if mark and mark.visible and mark.color
+            and tonumber(mark.clientWidth) and tonumber(mark.clientHeight)
+            and tonumber(mark.clientWidth) > 1 and tonumber(mark.clientHeight) > 1 then
+
+            local screenX = tonumber(mark.screenX) or 0
+            local screenY = tonumber(mark.screenY) or 0
+            local clientWidth = tonumber(mark.clientWidth)
+            local clientHeight = tonumber(mark.clientHeight)
+            local uiX = screenX / clientWidth * uiWidth
+            local uiY = (clientHeight - screenY) / clientHeight * uiHeight
+
+            local model = GetWorldModel(mark.color)
+            model:ClearAllPoints()
+            model:SetPoint("CENTER", UIParent, "BOTTOMLEFT", uiX + offsetX, uiY + offsetY)
+            model:Show()
+            shown[mark.color] = true
+        end
+    end
+
+    for color, model in pairs(modelFrames) do
+        if not shown[color] then model:Hide() end
+    end
+end
+
+local modelUpdater = CreateFrame("Frame", "MoonMarkerModelUpdater", UIParent)
+modelUpdater:SetScript("OnUpdate", function()
+    modelElapsed = modelElapsed + (arg1 or 0)
+    if modelElapsed < MODEL_UPDATE_INTERVAL then return end
+    modelElapsed = 0
+    UpdateWorldModels()
+end)
+
+local function ModelSettingsStatus()
+    Print(string.format(
+        "M2=%s，尺寸=%s，偏移=(%s,%s)，缩放=%s，模型位置=(%s,%s,%s)，动画=%s",
+        MoonMarkerDB.modelEnabled == false and "关闭" or "开启",
+        tostring(MoonMarkerDB.modelSize or modelDefaults.size),
+        tostring(MoonMarkerDB.modelOffsetX or modelDefaults.offsetX),
+        tostring(MoonMarkerDB.modelOffsetY or modelDefaults.offsetY),
+        tostring(MoonMarkerDB.modelScale or modelDefaults.scale),
+        tostring(MoonMarkerDB.modelPositionX or modelDefaults.positionX),
+        tostring(MoonMarkerDB.modelPositionY or modelDefaults.positionY),
+        tostring(MoonMarkerDB.modelPositionZ or modelDefaults.positionZ),
+        tostring(MoonMarkerDB.modelSequence or modelDefaults.sequence)))
+end
+
+local function HandleModelCommand(message)
+    local command = string.lower(message or "")
+    command = string.gsub(command, "^%s+", "")
+    command = string.gsub(command, "%s+$", "")
+
+    if command == "" or command == "status" then
+        ModelSettingsStatus()
+        return
+    end
+    if command == "on" or command == "show" then
+        MoonMarkerDB.modelEnabled = true
+        Print("原版月光 M2 已开启")
+        return
+    end
+    if command == "off" or command == "hide" then
+        MoonMarkerDB.modelEnabled = false
+        HideWorldModels()
+        Print("原版月光 M2 已关闭")
+        return
+    end
+    if command == "reload" then
+        ReloadWorldModels()
+        Print("原版月光 M2 已重新加载")
+        return
+    end
+    if command == "reset" then
+        MoonMarkerDB.modelEnabled = true
+        MoonMarkerDB.modelSize = modelDefaults.size
+        MoonMarkerDB.modelOffsetX = modelDefaults.offsetX
+        MoonMarkerDB.modelOffsetY = modelDefaults.offsetY
+        MoonMarkerDB.modelScale = modelDefaults.scale
+        MoonMarkerDB.modelPositionX = modelDefaults.positionX
+        MoonMarkerDB.modelPositionY = modelDefaults.positionY
+        MoonMarkerDB.modelPositionZ = modelDefaults.positionZ
+        MoonMarkerDB.modelFacing = modelDefaults.facing
+        MoonMarkerDB.modelSequence = modelDefaults.sequence
+        for _, model in pairs(modelFrames) do ApplyModelSettings(model) end
+        Print("M2 参数已重置")
+        return
+    end
+
+    local _, _, value = string.find(command, "^size%s+([%d%.%-]+)$")
+    if value then
+        value = tonumber(value)
+        if value and value >= 100 and value <= 1400 then
+            MoonMarkerDB.modelSize = value
+            for _, model in pairs(modelFrames) do ApplyModelSettings(model) end
+            Print("M2 窗口尺寸=" .. value)
+        else
+            Print("尺寸范围：100-1400")
+        end
+        return
+    end
+
+    local _, _, x, y = string.find(command, "^offset%s+([%d%.%-]+)%s+([%d%.%-]+)$")
+    if x and y then
+        MoonMarkerDB.modelOffsetX = tonumber(x) or 0
+        MoonMarkerDB.modelOffsetY = tonumber(y) or 0
+        Print("M2 屏幕偏移已更新")
+        return
+    end
+
+    local _, _, scale = string.find(command, "^scale%s+([%d%.%-]+)$")
+    if scale then
+        scale = tonumber(scale)
+        if scale and scale >= 0.05 and scale <= 10 then
+            MoonMarkerDB.modelScale = scale
+            for _, model in pairs(modelFrames) do ApplyModelSettings(model) end
+            Print("M2 模型缩放=" .. scale)
+        else
+            Print("缩放范围：0.05-10")
+        end
+        return
+    end
+
+    local _, _, px, py, pz = string.find(command,
+        "^pos%s+([%d%.%-]+)%s+([%d%.%-]+)%s+([%d%.%-]+)$")
+    if px and py and pz then
+        MoonMarkerDB.modelPositionX = tonumber(px) or 0
+        MoonMarkerDB.modelPositionY = tonumber(py) or 0
+        MoonMarkerDB.modelPositionZ = tonumber(pz) or 0
+        for _, model in pairs(modelFrames) do ApplyModelSettings(model) end
+        Print("M2 内部模型位置已更新")
+        return
+    end
+
+    local _, _, sequence = string.find(command, "^sequence%s+(%d+)$")
+    if sequence then
+        MoonMarkerDB.modelSequence = tonumber(sequence) or 0
+        for _, model in pairs(modelFrames) do ApplyModelSettings(model) end
+        Print("M2 动画序列=" .. sequence)
+        return
+    end
+
+    Print("命令：/mmodel status|on|off|reload|reset|size 数值|offset X Y|scale 数值|pos X Y Z|sequence 数值")
 end
 
