+bool createAdvancedTopModel(const std::string& colorName,
+                            const std::string& modelPath,
+                            const C3Vector& position,
+                            float scale,
+                            float yawDegrees,
+                            std::string& normalizedPath) {
+    const int selectedColor = colorIndex(colorName);
+    gLastErrorStage = "top_validate";
+    if (selectedColor < 0) {
+        gLastErrorStage = "top_unknown_color";
+        return false;
+    }
+    if (!normalizeModelPath(modelPath, normalizedPath)
+        || !std::isfinite(position.x) || !std::isfinite(position.y)
+        || !std::isfinite(position.z) || !std::isfinite(scale)
+        || !std::isfinite(yawDegrees)
+        || scale < kAdvancedMinScale || scale > kAdvancedMaxScale) {
+        gLastErrorStage = "top_invalid_arguments";
+        return false;
+    }
+
+    AdvancedPreviewSlot& slot = gAdvancedTopModels[static_cast<std::size_t>(selectedColor)];
+    releaseAdvancedTopModel(slot, false);
+    slot.position = position;
+    slot.scale = scale;
+    slot.yawDegrees = yawDegrees;
+    slot.path = normalizedPath;
+    slot.context = currentContext();
+    if (slot.context == nullptr) {
+        resetAdvancedTopModel(slot);
+        gLastErrorStage = "top_no_world_context";
+        return false;
+    }
+
+    ++gCreateCalls;
+    slot.model = reinterpret_cast<CreateModelProc>(kCreateModelAddress)(
+        slot.context, slot.path.c_str(), 0);
+    if (slot.model == nullptr) {
+        resetAdvancedTopModel(slot);
+        gLastErrorStage = "top_create_failed";
+        return false;
+    }
+    ++gCreateSuccesses;
+
+    if (readField<void*>(slot.model, 0x2C) != slot.context) {
+        gLastErrorStage = "top_context_mismatch";
+        releaseAdvancedTopModel(slot, false);
+        return false;
+    }
+
+    applyAdvancedTopWorldMatrix(slot);
+    const C3Vector white = {1.0f, 1.0f, 1.0f};
+    reinterpret_cast<SetAlphaProc>(kSetAlphaAddress)(slot.model, 1.0f);
+    reinterpret_cast<SetColorProc>(kSetColorAddress)(slot.model, &white);
+    reinterpret_cast<SetSequenceProc>(kSetSequenceAddress)(
+        slot.model, -1, 0, -1, 0, 1.0f, 1, 1);
+    reinterpret_cast<SetBooleanProc>(kSetActiveTimestampAddress)(slot.model, 1);
+    reinterpret_cast<SetBooleanProc>(kAttachToRenderListAddress)(slot.model, 1);
+    slot.active = true;
+
+    if (readField<void*>(slot.model, 0x44) == nullptr) {
+        gLastErrorStage = "top_render_list_missing";
+        releaseAdvancedTopModel(slot, false);
+        return false;
+    }
+
+    gLastErrorStage = pollAdvancedTopRenderReady(slot, 1)
+        ? "top_ready" : "top_waiting_resources";
+    return true;
+}
+
+bool clearAdvancedTopModel(const std::string& colorName) {
+    const int selectedColor = colorIndex(colorName);
+    if (selectedColor < 0) {
+        gLastErrorStage = "top_unknown_color";
+        return false;
+    }
+    releaseAdvancedTopModel(
+        gAdvancedTopModels[static_cast<std::size_t>(selectedColor)], true);
+    return true;
+}
+
+void clearAdvancedTopModels() {
+    for (AdvancedPreviewSlot& slot : gAdvancedTopModels) {
+        releaseAdvancedTopModel(slot, false);
+    }
+    gLastErrorStage = "top_cleared_all";
+}
+
+std::size_t advancedTopModelCount() {
+    std::size_t count = 0;
+    for (const AdvancedPreviewSlot& slot : gAdvancedTopModels) {
+        if (slot.active && slot.model != nullptr) ++count;
+    }
+    return count;
+}
