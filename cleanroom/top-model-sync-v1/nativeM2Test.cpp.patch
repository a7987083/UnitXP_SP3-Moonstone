+void applyAdvancedTopWorldMatrix(AdvancedPreviewSlot& slot) {
+    if (slot.model == nullptr) return;
+    float matrix[16] = {};
+    buildAdvancedWorldMatrix(slot.position, slot.scale, slot.yawDegrees, matrix);
+    reinterpret_cast<SetWorldMatrixProc>(kSetWorldMatrixAddress)(slot.model, matrix);
+}
+
+void resetAdvancedTopModel(AdvancedPreviewSlot& slot) {
+    slot.context = nullptr;
+    slot.model = nullptr;
+    slot.position = {};
+    slot.active = false;
+    slot.renderReady = false;
+    slot.scale = 1.0f;
+    slot.yawDegrees = 0.0f;
+    slot.path.clear();
+}
+
+void releaseAdvancedTopModel(AdvancedPreviewSlot& slot, bool updateStage) {
+    if (slot.model == nullptr) {
+        resetAdvancedTopModel(slot);
+        if (updateStage) gLastErrorStage = "top_cleared_no_model";
+        return;
+    }
+
+    void* liveContext = currentContext();
+    void* modelContext = readField<void*>(slot.model, 0x2C);
+    if (liveContext != nullptr && liveContext == slot.context
+        && modelContext == slot.context) {
+        reinterpret_cast<SetBooleanProc>(kAttachToRenderListAddress)(slot.model, 0);
+        reinterpret_cast<ReleaseModelProc>(kReleaseModelAddress)(slot.model);
+        ++gReleaseCalls;
+        if (updateStage) gLastErrorStage = "top_cleared";
+    } else {
+        ++gDroppedStalePointers;
+        if (updateStage) gLastErrorStage = "top_cleared_stale_context";
+    }
+    resetAdvancedTopModel(slot);
+}
+
+bool pollAdvancedTopRenderReady(AdvancedPreviewSlot& slot, int requestLoad) {
+    if (slot.model == nullptr) return false;
+    ++gLoadChecks;
+    const bool ready = reinterpret_cast<EnsureRenderReadyProc>(
+        kEnsureRenderReadyAddress)(slot.model, requestLoad, 1) != 0;
+    if (ready && !slot.renderReady) {
+        slot.renderReady = true;
+        ++gLoadReadyTransitions;
+    }
+    return ready;
+}
