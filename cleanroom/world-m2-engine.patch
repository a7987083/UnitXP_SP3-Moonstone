+void* currentM2Scene() {
+    void* scene = *reinterpret_cast<void**>(kM2ScenePointerAddress);
+    if (scene == nullptr || (reinterpret_cast<uintptr_t>(scene) & 1u) != 0u) {
+        return nullptr;
+    }
+    return scene;
+}
+
+bool createWorldModel(MarkSlot& slot) {
+    void* scene = currentM2Scene();
+    if (scene == nullptr) {
+        return false;
+    }
+
+    if (gM2Scene != nullptr && gM2Scene != scene) {
+        // The engine rebuilt its M2 scene (for example while changing world).
+        // Do not keep pointers owned by the previous scene.
+        for (MarkSlot& mark : gMarks) {
+            mark.model = nullptr;
+        }
+    }
+    gM2Scene = scene;
+
+    auto createModel = reinterpret_cast<M2CreateModelProc>(kM2CreateModelAddress);
+    slot.model = createModel(scene, kMoonBeamModelPath, 0);
+    if (slot.model == nullptr) {
+        return false;
+    }
+
+    const C3Vector white = {1.0f, 1.0f, 1.0f};
+    reinterpret_cast<M2SetAlphaProc>(kM2SetAlphaAddress)(slot.model, 1.0f);
+    reinterpret_cast<M2SetColorProc>(kM2SetColorAddress)(slot.model, &white);
+
+    // Match the sequence call used by the client spell-visual code. The M2
+    // loader accepts this while the model is still loading and applies it once
+    // the resource becomes ready.
+    reinterpret_cast<M2SetSequenceProc>(kM2SetSequenceAddress)(
+        slot.model, -1, 0, -1, 0, 1.0f, 1, 1);
+
+    ++gModelCreates;
+    return true;
+}
+
+bool updateWorldModel(MarkSlot& slot) {
+    if (!slot.active) {
+        releaseWorldModel(slot);
+        return false;
+    }
+    if (slot.model == nullptr && !createWorldModel(slot)) {
+        return false;
+    }
+
+    const C3Vector upAxis = {0.0f, 0.0f, 1.0f};
+    const C3Vector fixedScale = {1.0f, 1.0f, 1.0f};
+    reinterpret_cast<M2SetTransformProc>(kM2SetTransformAddress)(
+        slot.model, &slot.position, 0.0f, &upAxis, &fixedScale);
+    ++gModelUpdates;
+    return true;
+}
