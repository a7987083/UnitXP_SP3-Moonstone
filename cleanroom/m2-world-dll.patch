+std::size_t screenSnapshot(ScreenMarkInfo* output, std::size_t capacity) {
+    if (output == nullptr || capacity == 0) {
+        return 0;
+    }
+
+    std::size_t written = 0;
+    for (std::size_t i = 0; i < gMarks.size() && written < capacity; ++i) {
+        if (!gMarks[i].active) {
+            continue;
+        }
+        output[written].color = kColors[i].name;
+        output[written].visible = gScreenVisible[i];
+        output[written].screenX = gScreenX[i];
+        output[written].screenY = gScreenY[i];
+        output[written].clientWidth = gScreenClientWidth;
+        output[written].clientHeight = gScreenClientHeight;
+        ++written;
+    }
+    return written;
+}
