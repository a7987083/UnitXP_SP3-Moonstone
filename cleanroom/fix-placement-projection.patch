+        reinterpret_cast<LPVOID*>(&gOriginalGroundCursor));
+    if (status != MH_OK) {
+        gOriginalGroundCursor = nullptr;
+        return false;
+    }
+    gGroundCursorHookCreated = true;
+    return true;
+}
+
+bool shutdownGroundCursorHook() {
+    if (!gGroundCursorHookCreated) {
+        return true;
+    }
+    const MH_STATUS status = MH_RemoveHook(reinterpret_cast<LPVOID>(0x006E60F0));
+    gGroundCursorHookCreated = false;
+    gOriginalGroundCursor = nullptr;
+    gCaptureActive = false;
+    gCaptureReceived = false;
+    return status == MH_OK;
+}
+
+void updateProjectedMarks() {
+    resetProjected();
+    if (count() == 0) {
+        return;
+    }
+
+    const uint32_t camera = vanilla1121_getCamera();
+    if (camera == 0 || (camera & 1) != 0) {
+        return;
+    }
+
+    const C3Vector cameraPosition = vanilla1121_getCameraPosition(camera);
+    const RECT client = vanilla1121_gameClientRect();
+    const float clientWidth = static_cast<float>(client.right - client.left);
+    const float clientHeight = static_cast<float>(client.bottom - client.top);
+    if (clientWidth <= 1.0f || clientHeight <= 1.0f) {
+        return;
+    }
+
+    const float baseHeight = clientHeight * (300.0f / 768.0f);
+    const float timeSeconds = static_cast<float>(GetTickCount() & 0x00ffffff) / 1000.0f;
+    unsigned long projected = 0;
+
+    for (std::size_t i = 0; i < gMarks.size(); ++i) {
+        if (!gMarks[i].active) continue;
+
+        C3Vector world = gMarks[i].position;
+        const C3Vector screen = vanilla1121_worldToScreen(world);
+        if (!validScreenPoint(screen) || screen.x > clientWidth || screen.y > clientHeight) continue;
+
+        const float distance = distanceBetween(cameraPosition, gMarks[i].position);
+        if (!std::isfinite(distance) || distance > kMaxVisibleDistance) continue;
+
+        // Stage 1 keeps distance scaling. Stage 2 removes it after stability is confirmed.
+        const float perspective = clampFloat(18.0f / std::max(distance, 1.0f), 0.34f, 1.45f);
+        const float pulse = 0.985f + 0.015f * std::sin(timeSeconds * 1.75f + static_cast<float>(i));
