+        const float widthPixels = heightPixels * (kTextureWidth / kTextureHeight);
+        const float left = screen.x - widthPixels * 0.5f;
+        const float right = screen.x + widthPixels * 0.5f;
+        const float top = screen.y - heightPixels;
+        const float bottom = screen.y;
+        const int alpha = static_cast<int>(clampFloat(270.0f - distance * 0.7f, 150.0f, 255.0f));
+        const D3DCOLOR color = markerColor(i, alpha);
+
+        ProjectedSlot& slot = gProjected[i];
+        slot.visible = true;
+        slot.vertices[0] = {left,  top,    0.0f, 1.0f, color, 0.0f, 0.0f};
+        slot.vertices[1] = {right, top,    0.0f, 1.0f, color, 1.0f, 0.0f};
+        slot.vertices[2] = {left,  bottom, 0.0f, 1.0f, color, 0.0f, 1.0f};
