+bool autoRangePreviewContextValid(const AutoRangePreviewSlot& slot) {
+    if (slot.preview.model == nullptr || slot.preview.context == nullptr) return false;
+    void* liveContext = currentContext();
+    if (liveContext == nullptr || liveContext != slot.preview.context) return false;
+    return readField<void*>(slot.preview.model, 0x2C) == slot.preview.context;
