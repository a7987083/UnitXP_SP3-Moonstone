+bool parseGuidText(const std::string& input, std::uint64_t& value) {
+    std::string text;
+    for (const char c : input) {
+        if (c != ' ' && c != '\t' && c != '\r' && c != '\n') text.push_back(c);
+    }
+    if (text.empty()) return false;
+
+    std::size_t p = 0;
+    bool explicitHex = false;
+    if (text.size() > 2 && text[0] == '0' && (text[1] == 'x' || text[1] == 'X')) {
+        explicitHex = true;
+        p = 2;
+    }
+    if (p >= text.size()) return false;
+
+    bool hasHexAlpha = false;
+    for (std::size_t i = p; i < text.size(); ++i) {
+        const char c = text[i];
+        if ((c >= 'A' && c <= 'F') || (c >= 'a' && c <= 'f')) hasHexAlpha = true;
+        else if (c < '0' || c > '9') return false;
+    }
+
+    // SuperWoW normally exposes GUIDs as hexadecimal strings. Decimal is also
+    // accepted for diagnostics when it is clearly not a 16-digit hex GUID.
+    const unsigned base = (explicitHex || hasHexAlpha || (text.size() - p) == 16u) ? 16u : 10u;
+    std::uint64_t parsed = 0;
+    for (; p < text.size(); ++p) {
+        const char c = text[p];
+        unsigned digit = 0;
+        if (c >= '0' && c <= '9') digit = static_cast<unsigned>(c - '0');
+        else if (c >= 'A' && c <= 'F') digit = 10u + static_cast<unsigned>(c - 'A');
+        else if (c >= 'a' && c <= 'f') digit = 10u + static_cast<unsigned>(c - 'a');
+        else return false;
+        if (digit >= base) return false;
+        if (parsed > (std::numeric_limits<std::uint64_t>::max() - digit) / base) return false;
+        parsed = parsed * base + digit;
+    }
+    if (parsed == 0u) return false;
+    value = parsed;
+    return true;
+}
