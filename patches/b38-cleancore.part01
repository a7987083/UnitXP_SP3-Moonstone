 }
 
+bool hideAutoRangeVisual(const std::string& key) {
+    ++gAutoRangeHideCalls;
+    if (!runtimeReady("unsupported_client")) return false;
+    AutoRangePreviewSlot* slot = findAutoRangePreview(key);
+    if (slot == nullptr) return false;
+    if (slot->hidden) return true;
+    if (!autoRangePreviewContextValid(*slot)) {
+        gLastErrorStage = "autorange_hide_context_invalid";
+        return false;
+    }
+    reinterpret_cast<SetBooleanProc>(kAttachToRenderListAddress)(slot->preview.model, 0);
+    slot->hidden = true;
+    gLastErrorStage = "autorange_hidden";
+    return true;
+}
+
+bool showAutoRangeVisual(const std::string& key) {
+    ++gAutoRangeShowCalls;
+    if (!runtimeReady("unsupported_client")) return false;
+    AutoRangePreviewSlot* slot = findAutoRangePreview(key);
+    if (slot == nullptr) return false;
+    if (!autoRangePreviewContextValid(*slot)) {
+        gLastErrorStage = "autorange_show_context_invalid";
+        return false;
+    }
+    slot->hidden = false;
+    applyPreviewWorldMatrix(slot->preview);
+    reinterpret_cast<SetBooleanProc>(kSetActiveTimestampAddress)(slot->preview.model, 1);
+    reinterpret_cast<SetBooleanProc>(kAttachToRenderListAddress)(slot->preview.model, 1);
+    if (!slot->preview.renderReady)
+        pollPreviewRenderReady(slot->preview, 0);
+    gLastErrorStage = "autorange_shown";
+    return true;
+}
+
+bool restartAutoRangeVisual(const std::string& key) {
+    ++gAutoRangeRestartCalls;
+    if (!runtimeReady("unsupported_client")) return false;
+    AutoRangePreviewSlot* slot = findAutoRangePreview(key);
+    if (slot == nullptr || !autoRangePreviewContextValid(*slot)) {
+        gLastErrorStage = "autorange_restart_invalid";
+        return false;
+    }
+    reinterpret_cast<SetSequenceProc>(kSetSequenceAddress)(
+        slot->preview.model, -1, 0, -1, 0, 1.0f, 1, 1);
+    reinterpret_cast<SetBooleanProc>(kSetActiveTimestampAddress)(slot->preview.model, 1);
+    if (!slot->hidden && readField<void*>(slot->preview.model, 0x44) == nullptr)
+        reinterpret_cast<SetBooleanProc>(kAttachToRenderListAddress)(slot->preview.model, 1);
+    if (!slot->preview.renderReady)
+        pollPreviewRenderReady(slot->preview, 0);
+    gLastErrorStage = "autorange_restarted";
+    return true;
+}
+
+std::string autoRangeVisualStats() {
+    std::size_t active = 0u, hidden = 0u, models = 0u, keys = 0u;
+    for (const AutoRangePreviewSlot& slot : gAutoRangePreviews) {
+        if (slot.preview.active) ++active;
+        if (slot.hidden) ++hidden;
+        if (slot.preview.model != nullptr) ++models;
+        if (!slot.key.empty()) ++keys;
+    }
+    std::ostringstream out;
+    out << "V|active=" << active << "|hidden=" << hidden
+        << "|models=" << models << "|keys=" << keys
+        << "|set=" << gAutoRangeSetCalls << "|setOK=" << gAutoRangeSetSuccess
+        << "|move=" << gAutoRangeMoveCalls << "|hide=" << gAutoRangeHideCalls
+        << "|show=" << gAutoRangeShowCalls << "|restart=" << gAutoRangeRestartCalls
+        << "|clear=" << gAutoRangeClearCalls << "|clearSafe=" << gAutoRangeClearSafe
+        << "|clearStale=" << gAutoRangeClearStale;
+    return out.str();
+}
+
 void clearAutoRangeVisual(const std::string& key) {
+    ++gAutoRangeClearCalls;
     for (AutoRangePreviewSlot& slot : gAutoRangePreviews) {
         if (slot.key != key) continue;
+        if (slot.preview.model == nullptr || autoRangePreviewContextValid(slot))
+            ++gAutoRangeClearSafe;
+        else
+            ++gAutoRangeClearStale;
         releasePreview(slot.preview, false, "", "", "");
         slot.key.clear();
+        slot.hidden = false;
         gLastErrorStage = "autorange_cleared";
         return;
     }
