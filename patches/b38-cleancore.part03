+    if (!safeRead<std::uint32_t>(static_cast<std::uintptr_t>(object) + kObjectTypeOffset, type))
+        return "E|OBJECT_TYPE_UNREADABLE|dynamic object type is not readable";
+    if (type != OBJECT_TYPE_DynamicObject)
+        return std::string("E|GUID_NOT_DYNAMIC|") + hex64(guid);
+
+    std::uint32_t descriptor = 0u;
+    if (!descriptorPtr(object, descriptor))
+        return "E|DYNAMIC_DESCRIPTOR_INVALID|dynamic descriptor is not readable";
+
+    std::uint64_t caster = 0u;
+    std::uint32_t spellId = 0u;
+    float radius = 0.0f;
+    C3Vector pos = {};
+    if (!descriptorU64(descriptor, kDynamicCaster, caster)
+        || !descriptorU32(descriptor, kDynamicSpellId, spellId)
+        || !descriptorFloat(descriptor, kDynamicRadius, radius)
+        || !descriptorFloat(descriptor, kDynamicPosX, pos.x)
+        || !descriptorFloat(descriptor, kDynamicPosY, pos.y)
+        || !descriptorFloat(descriptor, kDynamicPosZ, pos.z)
+        || !validPosition(pos) || !validWorldFloat(radius))
+        return "E|DYNAMIC_FIELDS_INVALID|dynamic fields are not readable";
+
+    float xy = 0.0f, zdiff = 0.0f;
+    const std::uint64_t playerGuid = vanilla1121_unitGUID("player");
+    const std::uint32_t playerObject = vanilla1121_getVisiableObject(playerGuid);
+    if (playerObject != 0u && (playerObject & 1u) == 0u) {
+        const C3Vector playerPos = vanilla1121_unitPosition(playerObject);
+        if (validPosition(playerPos)) {
+            xy = distanceXY(playerPos, pos);
+            zdiff = std::fabs(playerPos.z - pos.z);
+        }
+    }
+
+    std::ostringstream out;
+    out.setf(std::ios::fixed);
+    out << std::setprecision(3);
+    out << "D|" << hex64(guid) << '|' << hex64(caster) << '|'
+        << spellId << '|' << radius << '|'
+        << pos.x << '|' << pos.y << '|' << pos.z << '|'
+        << xy << '|' << zdiff << '|'
+        << hex32(object) << '|' << hex32(descriptor);
+    return out.str();
+}
