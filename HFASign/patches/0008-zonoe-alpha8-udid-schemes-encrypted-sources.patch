new file mode 100644
index 0000000..de418da
--- /dev/null
+++ b/Ksign/Backend/Server/UDIDService.swift
@@ -0,0 +1,94 @@
+import Foundation
+import UIKit
+import Vapor
+import Security
+
+final class UDIDService {
+	static let shared = UDIDService()
+	static let didUpdateNotification = Notification.Name("zonoe.didUpdateUDID")
+	static let port = 14302
+	private var server: Application?
+
+	private init() {}
+
+	func start(completion: @escaping (Result<URL, Error>) -> Void) {
+		if server != nil {
+			completion(.success(profileURL))
+			return
+		}
+		do {
+			var environment = Environment(name: "zonoe-udid", arguments: ["zonoe"])
+			let app = Application(environment)
+			app.http.server.configuration.hostname = "127.0.0.1"
+			app.http.server.configuration.port = Self.port
+			app.routes.defaultMaxBodySize = "2mb"
+
+			app.get("profile.mobileconfig") { _ in
+				Response(status: .ok, headers: ["Content-Type": "application/x-apple-aspen-config"], body: .init(data: self.profileData()))
+			}
+			app.post("udid") { req -> Response in
+				guard let buffer = req.body.data else { return Response(status: .badRequest) }
+				var copy = buffer
+				let data = copy.readData(length: copy.readableBytes) ?? Data()
+				guard let udid = self.extractUDID(from: data) else { return Response(status: .badRequest) }
+				UserDefaults.standard.set(udid, forKey: "zonoe.deviceUDID")
+				DispatchQueue.main.async {
+					NotificationCenter.default.post(name: Self.didUpdateNotification, object: udid)
+				}
+				return Response(status: .ok, headers: ["Content-Type": "text/html; charset=utf-8"], body: .init(string: "<html><body style='font-family:-apple-system;text-align:center;padding-top:80px'><h2>UDID 获取成功</h2><p>请返回 zonoe。</p></body></html>"))
+			}
+			try app.server.start()
+			server = app
+			completion(.success(profileURL))
+		} catch {
+			completion(.failure(error))
+		}
+	}
+
+	private var profileURL: URL { URL(string: "http://127.0.0.1:\(Self.port)/profile.mobileconfig")! }
+
+	private func profileData() -> Data {
+		let dictionary: [String: Any] = [
+			"PayloadContent": ["URL": "http://127.0.0.1:\(Self.port)/udid", "DeviceAttributes": ["UDID"]],
+			"PayloadOrganization": "zonoe",
+			"PayloadDisplayName": "获取本机 UDID",
+			"PayloadVersion": 1,
+			"PayloadUUID": UUID().uuidString,
+			"PayloadIdentifier": "com.zonoe.udid.profile-service",
+			"PayloadDescription": "仅用于向本机 zonoe 返回设备 UDID",
+			"PayloadType": "Profile Service"
+		]
+		return (try? PropertyListSerialization.data(fromPropertyList: dictionary, format: .xml, options: 0)) ?? Data()
+	}
+
+	private func extractUDID(from input: Data) -> String? {
+		let candidates = [decodeCMS(input), input].compactMap { $0 }
+		for data in candidates {
+			if let plist = try? PropertyListSerialization.propertyList(from: data, options: [], format: nil),
+			   let value = findUDID(in: plist) { return value }
+		}
+		return nil
+	}
+
+	private func findUDID(in value: Any) -> String? {
+		if let dict = value as? [String: Any] {
+			if let udid = dict["UDID"] as? String, !udid.isEmpty { return udid }
+			for nested in dict.values { if let result = findUDID(in: nested) { return result } }
+		} else if let array = value as? [Any] {
+			for nested in array { if let result = findUDID(in: nested) { return result } }
+		}
+		return nil
+	}
+
+	private func decodeCMS(_ data: Data) -> Data? {
+		var decoder: CMSDecoder?
+		guard CMSDecoderCreate(&decoder) == errSecSuccess, let decoder else { return nil }
+		let updateStatus = data.withUnsafeBytes { bytes in
+			CMSDecoderUpdateMessage(decoder, bytes.baseAddress, data.count)
+		}
+		guard updateStatus == errSecSuccess, CMSDecoderFinalizeMessage(decoder) == errSecSuccess else { return nil }
+		var content: CFData?
+		guard CMSDecoderCopyContent(decoder, &content) == errSecSuccess else { return nil }
+		return content as Data?
+	}
+}
diff --git a/Ksign/Backend/Sources/SourceRepositoryLoader.swift b/Ksign/Backend/Sources/SourceRepositoryLoader.swift
new file mode 100644
index 0000000..bf081c1
--- /dev/null
+++ b/Ksign/Backend/Sources/SourceRepositoryLoader.swift
@@ -0,0 +1,81 @@
+import Foundation
+import AltSourceKit
+import CommonCrypto
+import CryptoKit
+
+final class SourceRepositoryLoader {
+	static let shared = SourceRepositoryLoader()
+	private init() {}
+
+	func fetch(from url: URL, completion: @escaping (Result<ASRepository, Error>) -> Void) {
+		URLSession.shared.dataTask(with: url) { data, _, networkError in
+			var latestError: Error = networkError ?? LoaderError.noData
+			if let data {
+				do {
+					let repository = try self.decode(data)
+					try? self.saveCache(data, for: url)
+					completion(.success(repository)); return
+				} catch { latestError = error }
+			}
+			if let cached = try? Data(contentsOf: self.cacheURL(for: url)), let repository = try? self.decode(cached) {
+				completion(.success(repository))
+			} else { completion(.failure(latestError)) }
+		}.resume()
+	}
+
+	private func cacheURL(for url: URL) -> URL {
+		let digest = SHA256.hash(data: Data(url.absoluteString.utf8)).map { String(format: "%02x", $0) }.joined()
+		let root = FileManager.default.urls(for: .cachesDirectory, in: .userDomainMask)[0].appendingPathComponent("SourceCache", isDirectory: true)
+		try? FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)
+		return root.appendingPathComponent(digest).appendingPathExtension("json")
+	}
+
+	private func saveCache(_ data: Data, for url: URL) throws { try data.write(to: cacheURL(for: url), options: .atomic) }
+
+	private func decode(_ data: Data) throws -> ASRepository {
+		let decoder = JSONDecoder()
+		if let direct = try? decoder.decode(ASRepository.self, from: data) { return direct }
+		guard let object = try JSONSerialization.jsonObject(with: data) as? [String: Any],
+			  let encrypted = object["appstore"] as? String else { throw LoaderError.unsupportedFormat }
+		var compact = encrypted.trimmingCharacters(in: .whitespacesAndNewlines)
+			.replacingOccurrences(of: "-", with: "+")
+			.replacingOccurrences(of: "_", with: "/")
+		while compact.count % 4 != 0 { compact.append("=") }
+		guard let cipher = Data(base64Encoded: compact, options: [.ignoreUnknownCharacters]) else {
+			throw LoaderError.invalidEncryptedPayload
+		}
+		let plain = try decryptDES(cipher)
+		return try decoder.decode(ASRepository.self, from: plain)
+	}
+
+	private func decryptDES(_ encrypted: Data) throws -> Data {
+		let key = Data("esign_so".utf8)
+		let iv = Data("urce_enc".utf8)
+		var output = Data(count: encrypted.count + kCCBlockSizeDES)
+		var moved = 0
+		let status = output.withUnsafeMutableBytes { outputBytes in
+			encrypted.withUnsafeBytes { inputBytes in
+				key.withUnsafeBytes { keyBytes in
+					iv.withUnsafeBytes { ivBytes in
+						CCCrypt(CCOperation(kCCDecrypt), CCAlgorithm(kCCAlgorithmDES), CCOptions(kCCOptionPKCS7Padding), keyBytes.baseAddress, kCCKeySizeDES, ivBytes.baseAddress, inputBytes.baseAddress, encrypted.count, outputBytes.baseAddress, output.count, &moved)
+					}
+				}
+			}
+		}
+		guard status == kCCSuccess else { throw LoaderError.decryptionFailed(status) }
+		output.removeSubrange(moved..<output.count)
+		return output
+	}
+
+	enum LoaderError: LocalizedError {
+		case noData, unsupportedFormat, invalidEncryptedPayload, decryptionFailed(CCCryptorStatus)
+		var errorDescription: String? {
+			switch self {
+			case .noData: return "软件源没有返回数据"
+			case .unsupportedFormat: return "不支持的软件源格式"
+			case .invalidEncryptedPayload: return "全能签 appstore 字段不是有效 Base64"
+			case .decryptionFailed(let status): return "全能签软件源解密失败（\(status)）"
+			}
+		}
+	}
+}
