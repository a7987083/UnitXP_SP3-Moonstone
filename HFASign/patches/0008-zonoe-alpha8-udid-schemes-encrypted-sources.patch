+import SwiftUI
+import UIKit
+
+struct URLSchemeView: View {
+	var body: some View {
+		List {
+			Section("添加软件源") {
+				endpoint("zonoe://source/[软件源 URL]")
+				Text("打开 zonoe 并添加 AltStore、ESign 或全能签软件源。")
+			}
+			Section("下载并导入") {
+				endpoint("zonoe://install/[文件 URL]")
+				Text("下载 IPA、TIPA 或支持的资源文件。")
+			}
+			Section("读取 UDID") {
+				endpoint("zonoe://udid?callback=[回调 URL]")
+				Text("zonoe 会在回调 URL 中追加 udid 参数；未提供 callback 时复制 UDID。")
+			}
+		}
+		.navigationTitle("URL Scheme")
+		.navigationBarTitleDisplayMode(.inline)
+	}
+
+	private func endpoint(_ value: String) -> some View {
+		Button {
+			UIPasteboard.general.string = value
+		} label: {
+			HStack {
+				Text(value).font(.system(.footnote, design: .monospaced)).foregroundStyle(.primary)
+				Spacer(); Image(systemName: "doc.on.doc")
+			}
+		}
+	}
+}
