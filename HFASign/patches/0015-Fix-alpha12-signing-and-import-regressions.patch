+
+	private func validateCertificateSignedApp(_ app: URL) throws {
+		let provisionURL = app.appendingPathComponent("embedded.mobileprovision")
+		let codeResourcesURL = app.appendingPathComponent("_CodeSignature/CodeResources")
+		guard fileExistsAndIsNotEmpty(provisionURL) else { throw SigningFileHandlerError.missingEmbeddedProvision }
+		guard fileExistsAndIsNotEmpty(codeResourcesURL) else { throw SigningFileHandlerError.missingCodeResources }
+		guard let bundle = Bundle(url: app),
+			let bundleID = bundle.bundleIdentifier,
+			let executableURL = bundle.executableURL,
+			fileExistsAndIsNotEmpty(executableURL) else { throw SigningFileHandlerError.missingSignedExecutable }
+		guard let provision = CertificateReader(provisionURL).decoded,
+			let applicationIdentifier = provision.Entitlements?["application-identifier"]?.value as? String,
+			isBundleIdentifier(bundleID, allowedBy: applicationIdentifier) else {
+			throw SigningFileHandlerError.provisioningIdentifierMismatch
+		}
+		OperationProgressManager.shared.log("签名结构校验通过：描述文件、CodeResources、Bundle ID")
+	}
+
+	private func fileExistsAndIsNotEmpty(_ url: URL) -> Bool {
+		guard _fileManager.fileExists(atPath: url.path) else { return false }
+		let values = try? url.resourceValues(forKeys: [.fileSizeKey])
+		return (values?.fileSize ?? 0) > 0
+	}
+
+	private func isBundleIdentifier(_ bundleID: String, allowedBy applicationIdentifier: String) -> Bool {
+		let allowed = applicationIdentifier.split(separator: ".", maxSplits: 1).dropFirst().first.map(String.init) ?? applicationIdentifier
+		if allowed == "*" { return true }
+		if allowed.hasSuffix("*") { return bundleID.hasPrefix(String(allowed.dropLast())) }
+		return bundleID == allowed
+	}
 	
 	private func _inject(for app: URL, with tweaks: [URL], with options: Options) async throws {
 		let handler = TweakHandler(app: app, with: tweaks, options: options)
