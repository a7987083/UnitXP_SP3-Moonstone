+	private func decodedArchivePath(_ entry: ZIPFoundation.Entry) -> String {
+		let standard = entry.path
+		let gb18030 = entry.path(using: String.Encoding(rawValue: 0x80000632))
+		guard !gb18030.isEmpty,
+			containsCJK(gb18030),
+			!containsCJK(standard),
+			looksLikeLegacyMojibake(standard) else { return standard }
+		return gb18030
+	}
+
+	private func containsCJK(_ value: String) -> Bool {
+		value.unicodeScalars.contains { scalar in
+			(0x3400...0x9FFF).contains(scalar.value) || (0xF900...0xFAFF).contains(scalar.value)
+		}
+	}
+
+	private func looksLikeLegacyMojibake(_ value: String) -> Bool {
+		value.unicodeScalars.contains { scalar in
+			(0x0080...0x00FF).contains(scalar.value)
+				|| (0x0370...0x03FF).contains(scalar.value)
+				|| (0x2500...0x259F).contains(scalar.value)
+		}
+	}
+
