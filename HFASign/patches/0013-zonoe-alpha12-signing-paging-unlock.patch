+	private func applyPlistRule(_ rule: PlistMutationRule, to root: NSMutableDictionary) throws {
+		let path = rule.keyPath.trimmingCharacters(in: .whitespacesAndNewlines)
+		guard !path.isEmpty else { throw PlistMutationError.invalidValue("Key Path 为空") }
+		let value: Any
+		switch rule.type {
+		case .string: value = rule.value
+		case .bool:
+			guard let bool = Bool(rule.value.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()) else { throw PlistMutationError.invalidValue("Bool 必须是 true 或 false") }
+			value = bool
+		case .number:
+			guard let number = NumberFormatter().number(from: rule.value) else { throw PlistMutationError.invalidValue("Number 格式错误") }
+			value = number
+		case .data:
+			guard let data = Data(base64Encoded: rule.value.trimmingCharacters(in: .whitespacesAndNewlines)) else { throw PlistMutationError.invalidValue("Data 必须是 Base64") }
+			value = data
+		case .array, .dictionary:
+			guard let data = rule.value.data(using: .utf8) else { throw PlistMutationError.invalidValue("JSON 编码错误") }
+			let json = try JSONSerialization.jsonObject(with: data)
+			guard (rule.type == .array && json is [Any]) || (rule.type == .dictionary && json is [String: Any]) else { throw PlistMutationError.invalidValue("值与所选类型不符") }
+			value = json
+		}
+		let components = path.split(separator: ".").map(String.init)
+		guard let last = components.last else { throw PlistMutationError.invalidValue("Key Path 无效") }
+		var dictionary = root
+		for key in components.dropLast() {
+			if let existing = dictionary[key] as? NSMutableDictionary { dictionary = existing }
+			else if let existing = dictionary[key] as? [String: Any] { let mutable = NSMutableDictionary(dictionary: existing); dictionary[key] = mutable; dictionary = mutable }
+			else { let mutable = NSMutableDictionary(); dictionary[key] = mutable; dictionary = mutable }
+		}
+		dictionary[last] = value
+	}
 	
