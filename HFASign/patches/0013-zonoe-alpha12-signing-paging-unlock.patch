+struct PackageNameRule: Codable, Equatable {
+	var components: [Component] = []
+	var separator: Separator = .underscore
+
+	enum Component: String, Codable, CaseIterable, Identifiable {
+		case name, version, bundleID, certificate, timestamp
+		var id: String { rawValue }
+		var title: String {
+			switch self { case .name: return "名称"; case .version: return "版本号"; case .bundleID: return "Bundle ID"; case .certificate: return "证书名称"; case .timestamp: return "时间戳" }
+		}
+	}
+	enum Separator: String, Codable, CaseIterable, Identifiable {
+		case underscore = "_", hyphen = "-", space = " ", none = ""
+		var id: String { rawValue }
+		var title: String { rawValue.isEmpty ? "无" : rawValue == " " ? "空格" : rawValue }
+	}
+
+	func fileName(name: String, version: String, bundleID: String, certificate: String, date: Date = Date()) -> String? {
+		guard !components.isEmpty else { return nil }
+		let formatter = DateFormatter(); formatter.dateFormat = "yyyyMMdd_HHmmss"
+		let values = components.map { component -> String in
+			switch component { case .name: return name; case .version: return version; case .bundleID: return bundleID; case .certificate: return certificate; case .timestamp: return formatter.string(from: date) }
+		}
+		let invalid = CharacterSet(charactersIn: "/\\:*?\"<>|\n\r\t")
+		return values.map { $0.components(separatedBy: invalid).joined(separator: "-").trimmingCharacters(in: .whitespacesAndNewlines) }
+			.filter { !$0.isEmpty }.joined(separator: separator.rawValue)
+	}
+}
+
+struct PlistMutationRule: Codable, Equatable, Identifiable {
+	var id = UUID()
+	var keyPath = ""
+	var type: ValueType = .string
+	var value = ""
+	var isEnabled = true
+
+	enum ValueType: String, Codable, CaseIterable, Identifiable {
+		case string = "String", bool = "Bool", number = "Number", array = "Array", dictionary = "Dictionary", data = "Data"
+		var id: String { rawValue }
+	}
+}
+
 protocol LocalizedDescribable {
 	var localizedDescription: String { get }
 }
