+final class SourceUnlockService {
+	static let shared = SourceUnlockService()
+	private init() {}
+
+	func unlock(sourceURL: URL, code: String, completion: @escaping (Result<String, Error>) -> Void) {
+		guard let metadata = SourceRepositoryLoader.shared.accessMetadata(for: sourceURL), let endpoint = metadata.unlockURL else {
+			completion(.failure(UnlockError.missingEndpoint)); return
+		}
+		guard let udid = UserDefaults.standard.string(forKey: "zonoe.deviceUDID"), !udid.isEmpty else {
+			completion(.failure(UnlockError.missingUDID)); return
+		}
+		let cleanCode = code.trimmingCharacters(in: .whitespacesAndNewlines)
+		guard !cleanCode.isEmpty else { completion(.failure(UnlockError.emptyCode)); return }
+		guard var components = URLComponents(url: endpoint, resolvingAgainstBaseURL: false) else { completion(.failure(UnlockError.invalidEndpoint)); return }
+		var items = components.queryItems ?? []
+		items.removeAll { ["udid", "code"].contains($0.name.lowercased()) }
+		items.append(URLQueryItem(name: "udid", value: udid)); items.append(URLQueryItem(name: "code", value: cleanCode)); components.queryItems = items
+		guard let url = components.url else { completion(.failure(UnlockError.invalidEndpoint)); return }
+		URLSession.shared.dataTask(with: url) { data, response, error in
+			if let error { completion(.failure(error)); return }
+			if let http = response as? HTTPURLResponse, !(200...299).contains(http.statusCode) { completion(.failure(UnlockError.http(http.statusCode))); return }
+			guard let data else { completion(.failure(UnlockError.invalidResponse)); return }
+			let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any]
+			let message = (object?["msg"] as? String) ?? (object?["message"] as? String) ?? String(data: data, encoding: .utf8) ?? ""
+			let success = message.lowercased().contains("success") || message.lowercased().contains("ok") || message.contains("成功") || (object?["success"] as? Bool == true)
+			completion(success ? .success(message) : .failure(UnlockError.server(message.isEmpty ? "解锁失败" : message)))
+		}.resume()
+	}
+
+	enum UnlockError: LocalizedError {
+		case missingEndpoint, missingUDID, emptyCode, invalidEndpoint, invalidResponse, http(Int), server(String)
+		var errorDescription: String? { switch self {
+		case .missingEndpoint: return "该软件源未提供解锁接口"; case .missingUDID: return "请先在设置中获取本机 UDID"; case .emptyCode: return "请输入解锁码"; case .invalidEndpoint: return "软件源解锁接口无效"; case .invalidResponse: return "解锁服务器没有返回有效数据"; case .http(let code): return "解锁服务器返回 HTTP \(code)"; case .server(let message): return message
+		} }
+	}
+}
