+		List {
+			Section("组合字段（按选择顺序）") {
+				ForEach(PackageNameRule.Component.allCases) { component in
+					Button { toggle(component) } label: {
+						HStack { Text(component.title); Spacer(); if draft.components.contains(component) { Image(systemName: "checkmark.circle.fill") } }
+					}.foregroundStyle(.primary)
+				}
+				.onMove { draft.components.move(fromOffsets: $0, toOffset: $1); save() }
+			}
+			Section("连接符") {
+				Picker("连接符", selection: $draft.separator) {
+					ForEach(PackageNameRule.Separator.allCases) { Text($0.title).tag($0) }
+				}.onChange(of: draft.separator) { _ in save() }
+			}
+			Section {
+				Text(preview).font(.system(.body, design: .monospaced)).textSelection(.enabled)
+			} header: { Text("预览") } footer: {
+				Text("未选择规则时沿用原文件名；手动修改输出文件名会覆盖本次规则。")
+			}
+		}
+		.navigationTitle("打包名字规则")
+		.toolbar { EditButton() }
+		.onAppear { draft = rule ?? PackageNameRule() }
+	}
+
+	private var preview: String { (draft.fileName(name: previewValues.name, version: previewValues.version, bundleID: previewValues.bundleID, certificate: previewValues.certificate) ?? previewValues.name) + ".ipa" }
+	private func toggle(_ component: PackageNameRule.Component) {
+		if let index = draft.components.firstIndex(of: component) { draft.components.remove(at: index) } else { draft.components.append(component) }
+		save()
+	}
+	private func save() { rule = draft.components.isEmpty ? nil : draft }
+}
+
+struct PlistRulesView: View {
+	@Binding var rules: [PlistMutationRule]?
+	@State private var draft: [PlistMutationRule] = []
+	@State private var editing: PlistMutationRule?
+
+	var body: some View {
+		List {
+			ForEach($draft) { $item in
+				Button { editing = item } label: {
+					HStack {
+						Toggle("", isOn: $item.isEnabled).labelsHidden()
+						VStack(alignment: .leading) {
+							Text(item.keyPath.isEmpty ? "未设置 Key Path" : item.keyPath)
+							Text(item.type.rawValue + " · " + item.value).font(.caption).foregroundStyle(.secondary)
+						}
+						Spacer()
+						Image(systemName: "chevron.right").foregroundStyle(.tertiary)
+					}
+				}.foregroundStyle(.primary)
+			}
+			.onDelete { draft.remove(atOffsets: $0); save() }
+			.onMove { draft.move(fromOffsets: $0, toOffset: $1); save() }
+			Section {
+				EmptyView()
+			} footer: {
+				Text("支持点分隔 Key Path 和数组下标；规则在标准修改后执行，因此可以覆盖名称、Bundle ID 等值。")
+			}
+		}
+		.navigationTitle("Info.plist 规则")
+		.toolbar { ToolbarItemGroup(placement: .topBarTrailing) { EditButton(); Button { editing = PlistMutationRule() } label: { Image(systemName: "plus") } } }
+		.sheet(item: $editing) { item in PlistRuleEditor(rule: item) { updated in
+			if let index = draft.firstIndex(where: { $0.id == updated.id }) { draft[index] = updated } else { draft.append(updated) }
+			save()
+		} }
+		.onAppear { draft = rules ?? [] }
+		.onChange(of: draft) { _ in save() }
+	}
+	private func save() { rules = draft.isEmpty ? nil : draft }
+}
+
+private struct PlistRuleEditor: View {
+	@Environment(\.dismiss) private var dismiss
+	@State var rule: PlistMutationRule
+	let save: (PlistMutationRule) -> Void
+	var body: some View {
+		NavigationStack {
+			Form {
+				TextField("Key Path，例如 CFBundleDisplayName", text: $rule.keyPath).textInputAutocapitalization(.never).autocorrectionDisabled()
+				Picker("类型", selection: $rule.type) { ForEach(PlistMutationRule.ValueType.allCases) { Text($0.rawValue).tag($0) } }
+				TextEditor(text: $rule.value).frame(minHeight: 120)
+				Toggle("启用", isOn: $rule.isEnabled)
+				Section {
+					EmptyView()
+				} footer: {
+					Text(rule.type == .array || rule.type == .dictionary ? "Array / Dictionary 使用 JSON 格式。Data 使用 Base64。" : "Bool 支持 true/false，Number 支持整数和小数。")
+				}
+			}
+			.navigationTitle("编辑规则").navigationBarTitleDisplayMode(.inline)
+			.toolbar { ToolbarItem(placement: .cancellationAction) { Button("取消") { dismiss() } }; ToolbarItem(placement: .confirmationAction) { Button("保存") { save(rule); dismiss() }.disabled(rule.keyPath.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty) } }
+		}
+	}
+}
