+
+struct AppleStoreProduct: Codable, Identifiable, Hashable {
+    let trackId: Int64
+    let bundleId: String?
+    let trackName: String?
+    let version: String?
+    let formattedPrice: String?
+    let price: Double?
+    let artistName: String?
+    let sellerName: String?
+    let description: String?
+    let artworkUrl512: URL?
+    let artworkUrl100: URL?
+    let minimumOsVersion: String?
+    let primaryGenreName: String?
+    let currentVersionReleaseDate: String?
+    let releaseNotes: String?
+    let fileSizeBytes: String?
+    let trackViewUrl: URL?
+    var id: Int64 { trackId }
+    var name: String { trackName ?? bundleId ?? "App" }
+}
+
+@MainActor final class AppleStoreSearchService: ObservableObject {
+    enum Device: String, CaseIterable, Identifiable { case iphone = "iPhone", ipad = "iPad", tv = "Apple TV"; var id: String { rawValue }; var entity: String { switch self { case .iphone: return "software"; case .ipad: return "iPadSoftware"; case .tv: return "software,tvSoftware" } } }
+    @Published var products: [AppleStoreProduct] = []
+    @Published var isLoading = false
+    @Published var errorMessage: String?
+
+    func search(term: String, country: String, device: Device) async {
+        let clean = term.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !clean.isEmpty else { products = []; return }
+        isLoading = true; errorMessage = nil
+        do {
+            async let search = request(path: "search", items: [.init(name:"term", value:clean), .init(name:"country", value:country), .init(name:"media", value:"software"), .init(name:"entity", value:device.entity), .init(name:"limit", value:"32")])
+            async let lookup = request(path: "lookup", items: [.init(name:"bundleId", value:clean), .init(name:"country", value:country), .init(name:"entity", value:device.entity), .init(name:"limit", value:"1")])
+            let values = try await lookup + search
+            products = Array(Dictionary(grouping: values, by: \.trackId).compactMap { $0.value.first }).sorted { $0.name.localizedCaseInsensitiveCompare($1.name) == .orderedAscending }
+        } catch { errorMessage = error.localizedDescription; products = [] }
+        isLoading = false
+    }
+    private func request(path: String, items: [URLQueryItem]) async throws -> [AppleStoreProduct] {
+        var components = URLComponents(string: "https://itunes.apple.com/\(path)")!; components.queryItems = items
+        let (data, response) = try await URLSession.shared.data(from: components.url!)
+        guard let http = response as? HTTPURLResponse, (200...299).contains(http.statusCode) else { throw URLError(.badServerResponse) }
+        return try JSONDecoder().decode(Response.self, from: data).results
+    }
+    private struct Response: Codable { let results: [AppleStoreProduct] }
+}
 
