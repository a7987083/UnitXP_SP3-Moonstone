+@MainActor
+final class SourceImportCoordinator: ObservableObject {
+	static let shared = SourceImportCoordinator()
+	@Published var clipboardCandidates: [URL] = []
+	@Published var isShowingClipboardPrompt = false
+	private let changeCountKey = "zonoe.lastClipboardSourceChangeCount"
+
+	func inspectClipboardIfChanged() {
+		let pasteboard = UIPasteboard.general
+		let count = pasteboard.changeCount
+		guard UserDefaults.standard.integer(forKey: changeCountKey) != count else { return }
+		UserDefaults.standard.set(count, forKey: changeCountKey)
+		guard let text = pasteboard.string else { return }
+		let urls = Self.extractURLs(from: text)
+		guard !urls.isEmpty else { return }
+		validateCandidates(urls, index: 0, valid: [])
+	}
+
+	private func validateCandidates(_ urls: [URL], index: Int, valid: [URL]) {
+		guard index < urls.count else {
+			guard !valid.isEmpty else { return }
+			clipboardCandidates = valid
+			isShowingClipboardPrompt = true
+			return
+		}
+		let url = urls[index]
+		SourceRepositoryLoader.shared.fetch(from: url) { result in
+			DispatchQueue.main.async {
+				var next = valid
+				if case .success = result { next.append(url) }
+				self.validateCandidates(urls, index: index + 1, valid: next)
+			}
+		}
+	}
+
+	static func extractURLs(from text: String) -> [URL] {
+		var strings = ASDeobfuscator(with: text).decode()
+		strings.append(text)
+		var seen = Set<String>()
+		var result: [URL] = []
+		let trailing = CharacterSet(charactersIn: "，。；：！？）》】)]}>,.;:!?")
+		for string in strings {
+			guard let detector = try? NSDataDetector(types: NSTextCheckingResult.CheckingType.link.rawValue) else { continue }
+			let range = NSRange(string.startIndex..., in: string)
+			for match in detector.matches(in: string, options: [], range: range) {
+				guard var raw = match.url?.absoluteString else { continue }
+				raw = raw.trimmingCharacters(in: trailing)
+				guard let url = URL(string: raw), ["http", "https"].contains(url.scheme?.lowercased() ?? ""), seen.insert(url.absoluteString).inserted else { continue }
+				result.append(url)
+			}
+		}
+		return result
+	}
+
+	func importSource(_ url: URL, completion: ((Bool) -> Void)? = nil) {
+		if Storage.shared.getSources().contains(where: { $0.sourceURL?.absoluteString == url.absoluteString }) {
+			UIAlertController.showAlertWithOk(title: "提示", message: "该软件源已添加")
+			completion?(false); return
+		}
+		SourceRepositoryLoader.shared.fetch(from: url) { result in
+			DispatchQueue.main.async {
+				switch result {
+				case .success(let repository):
+					let id = repository.id ?? url.absoluteString
+					guard !Storage.shared.sourceExists(id) else {
+						UIAlertController.showAlertWithOk(title: "提示", message: "该软件源已添加")
+						completion?(false); return
+					}
+					Storage.shared.addSource(url, repository: repository, id: id) { error in
+						if let error { UIAlertController.showAlertWithOk(title: "导入失败", message: error.localizedDescription); completion?(false) }
+						else { completion?(true) }
+					}
+				case .failure(let error):
+					UIAlertController.showAlertWithOk(title: "未识别为有效的软件源", message: error.localizedDescription)
+					completion?(false)
+				}
+			}
+		}
+	}
+}
+
+struct SourceClipboardPrompt: View {
+	@ObservedObject var coordinator: SourceImportCoordinator
+	@Environment(\.dismiss) private var dismiss
+	var body: some View {
+		NavigationStack {
+			List(coordinator.clipboardCandidates, id: \.absoluteString) { url in
+				VStack(alignment: .leading, spacing: 10) {
+					Text(url.absoluteString).font(.footnote).textSelection(.enabled)
+					Button("导入") { coordinator.importSource(url) { if $0 && coordinator.clipboardCandidates.count == 1 { dismiss() } } }.buttonStyle(.borderedProminent)
+				}
+				.padding(.vertical, 4)
 			}
+			.navigationTitle("检测到软件源")
+			.navigationBarTitleDisplayMode(.inline)
+			.toolbar { ToolbarItem(placement: .cancellationAction) { Button("取消") { dismiss() } } }
 		}
 	}
 }
