diff --git a/Ksign/Views/Signing/SigningView.swift b/Ksign/Views/Signing/SigningView.swift
index f80b3df..eec54e9 100644
--- a/Ksign/Views/Signing/SigningView.swift
+++ b/Ksign/Views/Signing/SigningView.swift
@@ -11,8 +11,8 @@ import NimbleViews
 
 // MARK: - View
 struct SigningView: View {
-	@Environment(\.dismiss) var dismiss
 	@Namespace var _namespace
+	private let onDismiss: () -> Void
 
 	@StateObject private var _optionsManager = OptionsManager.shared
 	@StateObject private var _operationProgress = OperationProgressManager.shared
@@ -30,6 +30,7 @@ struct SigningView: View {
 	@State private var _selectedPhoto: PhotosPickerItem? = nil
 	@FocusState private var _isOutputNameFocused: Bool
 	@State private var _rootDragOffset: CGFloat = 0
+	@State private var _isInteractiveBack = false
 	@State var appIcon: UIImage?
 	
 	var signAndInstall: Bool = false
@@ -60,9 +61,10 @@ struct SigningView: View {
 	
 	var app: AppInfoPresentable
 	
-	init(app: AppInfoPresentable, signAndInstall: Bool = false) {
+	init(app: AppInfoPresentable, signAndInstall: Bool = false, onDismiss: @escaping () -> Void = {}) {
 		self.app = app
 		self.signAndInstall = signAndInstall
+		self.onDismiss = onDismiss
 		let storedCert = UserDefaults.standard.integer(forKey: "feather.selectedCert")
 		__temporaryCertificate = State(initialValue: storedCert)
 	}
@@ -76,35 +78,8 @@ struct SigningView: View {
 				_customizationProperties(for: app)
 			}
 			.scrollDismissesKeyboard(.interactively)
+			.scrollDisabled(_isInteractiveBack)
 			.disabled(_isSigning)
-			.overlay(alignment: .leading) {
-				Color.clear
-					.frame(width: 22)
-					.contentShape(Rectangle())
-					.gesture(
-						DragGesture(minimumDistance: 4)
-							.onChanged { value in
-								guard value.translation.width > 0,
-									  abs(value.translation.width) > abs(value.translation.height) else { return }
-								_rootDragOffset = value.translation.width
-							}
-							.onEnded { value in
-								let isHorizontal = value.translation.width > 0 &&
-									abs(value.translation.width) > abs(value.translation.height)
-								let predicted = max(value.translation.width, value.predictedEndTranslation.width)
-								if isHorizontal && (value.translation.width > 90 || predicted > 180) {
-									withAnimation(.easeOut(duration: 0.16)) {
-										_rootDragOffset = UIScreen.main.bounds.width
-									}
-									DispatchQueue.main.asyncAfter(deadline: .now() + 0.14) { dismiss() }
-								} else {
-									withAnimation(.spring(response: 0.32, dampingFraction: 0.86)) {
-										_rootDragOffset = 0
-									}
-								}
-							}
-					)
-			}
 			.safeAreaInset(edge: .bottom) {
 				if !_isSigning {
 					Button() {
@@ -115,7 +90,9 @@ struct SigningView: View {
 				}
 			}
 			.toolbar {
-				NBToolbarButton(role: .dismiss)
+				NBToolbarButton(.localized("Dismiss"), systemImage: "chevron.left") {
+					_dismissRoot()
+				}
 				
 				NBToolbarButton(
 					.localized("重置"),
@@ -144,7 +121,7 @@ struct SigningView: View {
 			.fullScreenCover(isPresented: $_isSigning) {
 			SigningProcessView(manager: _operationProgress, promptInstall: signAndInstall || (_temporaryOptions.autoInstallAfterSigning ?? false)) {
 					_isSigning = false
-					dismiss()
+					_dismissRoot()
 				}
 			}
 			.onChange(of: _selectedPhoto) { newValue in
@@ -159,6 +136,13 @@ struct SigningView: View {
 			}
 			.animation(.smooth, value: _isSigning)
 		}
+		.overlay(alignment: .leading) {
+			Color.clear
+				.frame(width: 22)
+				.frame(maxHeight: .infinity)
+				.contentShape(Rectangle())
+				.gesture(_interactiveBackGesture)
+		}
 		.offset(x: _rootDragOffset)
 		.onAppear {
 			if _outputFileName.isEmpty {
@@ -209,6 +193,42 @@ struct SigningView: View {
 			}
 		}
     }
+
+	private var _interactiveBackGesture: some Gesture {
+		DragGesture(minimumDistance: 4)
+			.onChanged { value in
+				guard !_isSigning else { return }
+				if !_isInteractiveBack {
+					guard value.translation.width > 0,
+						  abs(value.translation.width) > abs(value.translation.height) else { return }
+					_isInteractiveBack = true
+				}
+				_rootDragOffset = max(0, value.translation.width)
+			}
+			.onEnded { value in
+				guard _isInteractiveBack else { return }
+				let predicted = max(value.translation.width, value.predictedEndTranslation.width)
+				if value.translation.width > 90 || predicted > 180 {
+					withAnimation(.easeOut(duration: 0.16)) {
+						_rootDragOffset = UIScreen.main.bounds.width
+					}
+					DispatchQueue.main.asyncAfter(deadline: .now() + 0.14) { _dismissRoot() }
+				} else {
+					withAnimation(.spring(response: 0.32, dampingFraction: 0.86)) {
+						_rootDragOffset = 0
+					}
+					DispatchQueue.main.asyncAfter(deadline: .now() + 0.32) {
+						_isInteractiveBack = false
+					}
+				}
+			}
+	}
+
+	private func _dismissRoot() {
+		_rootDragOffset = 0
+		_isInteractiveBack = false
+		onDismiss()
+	}
 }
 
 // MARK: - Extension: View
