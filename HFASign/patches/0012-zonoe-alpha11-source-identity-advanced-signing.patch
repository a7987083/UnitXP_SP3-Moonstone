 		}
 	}
 }
+
+enum SourceURLIdentity {
+	static func normalized(_ url: URL) -> URL {
+		guard var components = URLComponents(url: url, resolvingAgainstBaseURL: false) else { return url }
+		components.scheme = components.scheme?.lowercased()
+		components.host = components.host?.lowercased()
+		components.fragment = nil
+		if (components.scheme == "http" && components.port == 80)
+			|| (components.scheme == "https" && components.port == 443) {
+			components.port = nil
+		}
+		while components.percentEncodedPath.count > 1 && components.percentEncodedPath.hasSuffix("/") {
+			components.percentEncodedPath.removeLast()
+		}
+		return components.url ?? url
+	}
+
+	static func localID(for url: URL) -> String {
+		"source-url:\(normalized(url).absoluteString)"
+	}
+
+	static func matches(_ lhs: URL?, _ rhs: URL) -> Bool {
+		guard let lhs else { return false }
+		return normalized(lhs).absoluteString == normalized(rhs).absoluteString
+	}
+}
+
 @MainActor
 final class SourceImportCoordinator: ObservableObject {
 	static let shared = SourceImportCoordinator()
@@ -320,20 +347,20 @@ final class SourceImportCoordinator: ObservableObject {
 	}
 
 	func importSource(_ url: URL, completion: ((Bool) -> Void)? = nil) {
-		if Storage.shared.getSources().contains(where: { $0.sourceURL?.absoluteString == url.absoluteString }) {
+		let sourceURL = SourceURLIdentity.normalized(url)
+		if Storage.shared.getSources().contains(where: { SourceURLIdentity.matches($0.sourceURL, sourceURL) }) {
 			UIAlertController.showAlertWithOk(title: "提示", message: "该软件源已添加")
 			completion?(false); return
 		}
-		SourceRepositoryLoader.shared.fetch(from: url) { result in
+		SourceRepositoryLoader.shared.fetch(from: sourceURL) { result in
 			DispatchQueue.main.async {
 				switch result {
 				case .success(let repository):
-					let id = repository.id ?? url.absoluteString
-					guard !Storage.shared.sourceExists(id) else {
+					guard !Storage.shared.sourceExists(url: sourceURL) else {
 						UIAlertController.showAlertWithOk(title: "提示", message: "该软件源已添加")
 						completion?(false); return
 					}
-					Storage.shared.addSource(url, repository: repository, id: id) { error in
+					Storage.shared.addSource(sourceURL, repository: repository) { error in
 						if let error { UIAlertController.showAlertWithOk(title: "导入失败", message: error.localizedDescription); completion?(false) }
 						else { completion?(true) }
 					}
