@@ -52,17 +52,15 @@ extension Storage {
 	func addSource(
 		_ url: URL,
 		repository: ASRepository,
-		id: String = "",
 		deferSave: Bool = false,
 		isBuiltIn: Bool = false,
 		completion: @escaping (Error?) -> Void
 	) {
+		let normalizedURL = SourceURLIdentity.normalized(url)
 		addSource(
-			url,
+			normalizedURL,
 			name: repository.name,
-			identifier: !id.isEmpty
-						? id
-						: (repository.id ?? url.absoluteString),
+			identifier: SourceURLIdentity.localID(for: normalizedURL),
 			iconURL: repository.currentIconURL,
 			deferSave: deferSave,
 			isBuiltIn: isBuiltIn,
@@ -122,4 +120,9 @@ extension Storage {
 			return false
 		}
 	}
+
+	func sourceExists(url: URL) -> Bool {
+		let normalizedURL = SourceURLIdentity.normalized(url)
+		return getSources().contains { SourceURLIdentity.matches($0.sourceURL, normalizedURL) }
+	}
 }
