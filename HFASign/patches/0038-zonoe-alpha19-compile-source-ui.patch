@@ -133,7 +133,7 @@ extension SourceAppsTableRepresentableView { class Coordinator: NSObject, UITabl
     
     private func _calculateSortedApps() -> [(source: ASRepository, sourceURL: URL, app: ASRepository.App)] {
         let filtered = _allAppsWithSource.filter { entry in
-            let metadata = SourceRepositoryLoader.shared.appMetadata(for: entry.sourceURL, appIdentifier: entry.app.bundleIdentifier, appName: entry.app.currentName)
+            let metadata = SourceRepositoryLoader.shared.appMetadata(for: entry.sourceURL, appIdentifier: entry.app.id, appName: entry.app.currentName)
             let matchesSearch = searchText.isEmpty || entry.app.currentName.localizedCaseInsensitiveContains(searchText) || (metadata?.rawFields.values.contains { $0.displayText?.localizedCaseInsensitiveContains(searchText) == true } ?? false)
             let matchesCategory: Bool
             if filter.category == .all { matchesCategory = true } else {
@@ -153,7 +153,7 @@ extension SourceAppsTableRepresentableView { class Coordinator: NSObject, UITabl
     }
 
 	private func date(for entry: (source: ASRepository, sourceURL: URL, app: ASRepository.App)) -> Date {
-		SourceRepositoryLoader.shared.appMetadata(for: entry.sourceURL, appIdentifier: entry.app.bundleIdentifier, appName: entry.app.currentName)?.updatedAt ?? entry.app.currentDate?.date ?? .distantPast
+		SourceRepositoryLoader.shared.appMetadata(for: entry.sourceURL, appIdentifier: entry.app.id, appName: entry.app.currentName)?.updatedAt ?? entry.app.currentDate?.date ?? .distantPast
 	}
     
     func invalidateCache() {
