+	func hasLegacyGrant(sourceURL: URL, appIdentifier: String?, appName: String) -> Bool {
+		let udid = UserDefaults.standard.string(forKey: "zonoe.deviceUDID")?.trimmingCharacters(in: .whitespacesAndNewlines) ?? ""
+		guard !udid.isEmpty else { return false }
+		return UserDefaults.standard.bool(forKey: legacyGrantKey(sourceURL: sourceURL, appIdentifier: appIdentifier, appName: appName, udid: udid))
+	}
+
+	private func markLegacyGrant(sourceURL: URL, appIdentifier: String?, appName: String, udid: String) {
+		UserDefaults.standard.set(true, forKey: legacyGrantKey(sourceURL: sourceURL, appIdentifier: appIdentifier, appName: appName, udid: udid))
+	}
+
+	private func legacyGrantKey(sourceURL: URL, appIdentifier: String?, appName: String, udid: String) -> String {
+		let identity = appIdentifier?.isEmpty == false ? "id:\(appIdentifier!)" : "name:\(appName)"
+		let raw = "\(SourceURLIdentity.normalized(sourceURL).absoluteString)\n\(udid)\n\(identity)"
+		let digest = SHA256.hash(data: Data(raw.utf8)).map { String(format: "%02x", $0) }.joined()
+		return "zonoe.sourceUnlock.\(digest)"
+	}
+
 	private func md5(_ value: String) -> String {
