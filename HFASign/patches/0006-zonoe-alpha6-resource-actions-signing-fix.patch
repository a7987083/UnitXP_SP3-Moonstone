+	}
+
+	var body: some View {
+		NavigationStack {
+			List {
+				Section("Mach-O 依赖") {
+					ForEach(dependencies, id: \.self) { dependency in
+						Button {
+							replacement = dependency; editingDependency = dependency
+						} label: {
+							VStack(alignment: .leading, spacing: 4) {
+								Text(dependency).font(.system(.body, design: .monospaced)).foregroundStyle(.primary)
+								Text("点击修改加载路径").font(.caption).foregroundStyle(.secondary)
+							}
+						}
+					}
+				}
+			}
+			.navigationTitle(fileURL.lastPathComponent)
+			.navigationBarTitleDisplayMode(.inline)
+			.toolbar { ToolbarItem(placement: .topBarLeading) { Button("关闭") { dismiss() } } }
+			.alert("修改依赖", isPresented: Binding(get: { editingDependency != nil }, set: { if !$0 { editingDependency = nil } })) {
+				TextField("新加载路径", text: $replacement)
+				Button("取消", role: .cancel) { editingDependency = nil }
+				Button("保存") {
+					if let old = editingDependency, !replacement.isEmpty {
+						let ok = Zsign.changeDylibPath(appExecutable: executableURL.path, for: old, with: replacement)
+						if !ok { UIAlertController.showAlertWithOk(title: "修改失败", message: "新路径不能比原路径更长，或 Mach-O 不支持修改。") }
+					}
+					editingDependency = nil; load()
+				}
+			}
+			.onAppear(perform: load)
+		}
+	}
+
+	private func load() {
+		dependencies = Zsign.listDylibs(appExecutable: executableURL.path).map { $0 as String }
+	}
+}
