+private struct StandaloneDylibDependenciesView: View {
+	@Environment(\.dismiss) private var dismiss
+	let fileURL: URL
+	@State private var dependencies: [String] = []
+	@State private var editingDependency: String?
+	@State private var replacement = ""
+
