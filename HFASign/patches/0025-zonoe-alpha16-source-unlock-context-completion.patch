+	private var isSourceLocked: Bool {
+		_ = unlockStateVersion
+		if let access = SourceRepositoryLoader.shared.appAccessMetadata(for: sourceURL, appIdentifier: app.id, appName: app.currentName),
+		   let needLock = access.isNeedLock {
+			if !needLock { return false }
+			return !SourceUnlockService.shared.hasLegacyGrant(sourceURL: sourceURL, appIdentifier: app.id, appName: app.currentName)
+		}
+		return app.currentDownloadUrl == nil
+	}
+
 	private func openPurchase() {
 		guard let url = SourceRepositoryLoader.shared.accessMetadata(for: sourceURL)?.payURL else { unlockError = "该软件源未提供解锁码获取地址"; return }
 		if ["http", "https"].contains(url.scheme?.lowercased() ?? "") { purchaseURL = url } else { UIApplication.shared.open(url) }
