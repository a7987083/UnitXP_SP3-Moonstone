+
+	static func decode(_ data: Data) async throws -> Data {
+		let object: Any
+		do { object = try JSONSerialization.jsonObject(with: data, options: [.fragmentsAllowed]) }
+		catch { throw DecodeError("软件源外层 JSON 无效：\(error.localizedDescription)") }
+		guard let root = object as? [String: Any] else { return data }
+		if let payload = root["appstore_v2"] as? String { return try decodeV2(payload) }
+		if let payload = root["appstore"] as? String { return try await decodeLegacy(payload) }
+		return data
+	}
+
+	private static func decodeLegacy(_ payload: String) async throws -> Data {
+		let encrypted = try base64(payload)
+		let update = try await get(legacyUpdateURL)
+		guard let encodedAKey = try dictionary(update, label: "update.json")["rule"] as? String else { throw DecodeError("update.json 缺少 rule") }
+		let akey = try base64(encodedAKey)
+		let keyResponse = try await get(legacyKeyURL)
+		guard let encodedBKey = try dictionary(keyResponse, label: "key.json")["rule"] as? String else { throw DecodeError("key.json 缺少 rule") }
+		let bkeyData = try rsaDecrypt(try base64(encodedBKey), privateKeyPEM: akey)
+		guard let bkey = String(data: bkeyData, encoding: .utf8), !bkey.isEmpty else { throw DecodeError("动态 bkey 不是 UTF-8") }
+		return try validateJSON(rc4(encrypted, keyText: bkey), label: "Legacy appstore")
+	}
+
+	private static func decodeV2(_ payload: String) throws -> Data {
+		let raw = try decodeV2Codec(payload)
+		guard raw.count >= 12, u32LE(raw, 0) == v2Magic else { throw DecodeError("appstore_v2 container magic 无效") }
+		let rsaLength = Int(u32LE(raw, 4)), rsaStart = 8, rsaEnd = rsaStart + rsaLength
+		guard rsaLength > 0, rsaEnd + 4 <= raw.count else { throw DecodeError("appstore_v2 RSA 长度越界") }
+		let payloadLength = Int(u32LE(raw, rsaEnd)), payloadStart = rsaEnd + 4, payloadEnd = payloadStart + payloadLength
+		guard payloadLength > 0, payloadEnd <= raw.count else { throw DecodeError("appstore_v2 payload 长度越界") }
+		let keyData = try rsaDecrypt(raw.subdata(in: rsaStart..<rsaEnd), privateKeyPEM: Data(v2PrivateKeyPEM.utf8))
+		guard let keyText = String(data: keyData, encoding: .utf8), !keyText.isEmpty else { throw DecodeError("appstore_v2 RC4 key 无效") }
+		return try validateJSON(rc4(raw.subdata(in: payloadStart..<payloadEnd), keyText: keyText), label: "appstore_v2")
+	}
+
+	private static func get(_ url: URL) async throws -> Data {
+		var request = URLRequest(url: url); request.timeoutInterval = 30; request.cachePolicy = .reloadIgnoringLocalCacheData
+		request.setValue("zonoe/3.0", forHTTPHeaderField: "User-Agent")
+		let (data, response) = try await URLSession.shared.data(for: request)
+		guard let http = response as? HTTPURLResponse, (200...299).contains(http.statusCode) else { throw DecodeError("\(url.lastPathComponent) 请求失败") }
+		return data
+	}
+
+	private static func dictionary(_ data: Data, label: String) throws -> [String: Any] {
+		guard let result = try JSONSerialization.jsonObject(with: data, options: [.fragmentsAllowed]) as? [String: Any] else { throw DecodeError("\(label) 不是 JSON object") }
+		return result
+	}
+
+	private static func base64(_ text: String) throws -> Data {
+		var compact = text.components(separatedBy: .whitespacesAndNewlines).joined().replacingOccurrences(of: "-", with: "+").replacingOccurrences(of: "_", with: "/")
+		if compact.count % 4 != 0 { compact += String(repeating: "=", count: 4 - compact.count % 4) }
+		guard let data = Data(base64Encoded: compact, options: [.ignoreUnknownCharacters]) else { throw DecodeError("Base64 数据无效") }
+		return data
+	}
+
+	private static func decodeV2Codec(_ text: String) throws -> Data {
+		var lookup = [Int](repeating: -1, count: 256)
+		for (index, byte) in v2Alphabet.enumerated() { lookup[Int(byte)] = index }
+		var output = Data(), accumulator: UInt64 = 0, bitCount = 0
+		for byte in text.utf8 {
+			guard byte < 128, lookup[Int(byte)] >= 0 else { throw DecodeError("appstore_v2 codec 字符无效") }
+			let value = lookup[Int(byte)], width = (value == 30 || value == 31) ? 5 : 6
+			accumulator |= UInt64(value & ((1 << width) - 1)) << UInt64(bitCount); bitCount += width
+			while bitCount >= 8 { output.append(UInt8(accumulator & 0xff)); accumulator >>= 8; bitCount -= 8 }
+		}
+		if bitCount > 0 { output.append(UInt8(accumulator & 0xff)) }
+		return output
+	}
+
+	private static func u32LE(_ data: Data, _ offset: Int) -> UInt32 {
+		UInt32(data[offset]) | (UInt32(data[offset + 1]) << 8) | (UInt32(data[offset + 2]) << 16) | (UInt32(data[offset + 3]) << 24)
+	}
+
+	private static func rc4(_ data: Data, keyText: String) -> Data {
+		let key = keyText.utf16.map { UInt8(truncatingIfNeeded: $0) }
+		var state = Array(0...255).map(UInt8.init), j = 0
+		for i in 0..<256 { j = (j + Int(state[i]) + Int(key[i % key.count])) & 0xff; state.swapAt(i, j) }
+		var i = 0; j = 0; var output = Data(capacity: data.count)
+		for byte in data { i = (i + 1) & 0xff; j = (j + Int(state[i])) & 0xff; state.swapAt(i, j); output.append(byte ^ state[(Int(state[i]) + Int(state[j])) & 0xff]) }
+		return output
+	}
+
+	private static func validateJSON(_ data: Data, label: String) throws -> Data {
+		guard String(data: data, encoding: .utf8) != nil else { throw DecodeError("\(label) 解密结果不是 UTF-8") }
+		do { _ = try JSONSerialization.jsonObject(with: data, options: [.fragmentsAllowed]); return data }
+		catch { throw DecodeError("\(label) 解密结果不是 JSON：\(error.localizedDescription)") }
+	}
+
+	private static func rsaDecrypt(_ ciphertext: Data, privateKeyPEM: Data) throws -> Data {
+		guard let pem = String(data: privateKeyPEM, encoding: .utf8) else { throw DecodeError("RSA private key 不是 UTF-8 PEM") }
+		let der = try privateKeyDER(pem)
+		let attributes: [CFString: Any] = [kSecAttrKeyType: kSecAttrKeyTypeRSA, kSecAttrKeyClass: kSecAttrKeyClassPrivate, kSecAttrKeySizeInBits: 2048]
+		var createError: Unmanaged<CFError>?
+		guard let key = SecKeyCreateWithData(der as CFData, attributes as CFDictionary, &createError) else { throw DecodeError("RSA private key 导入失败") }
+		let blockSize = SecKeyGetBlockSize(key)
+		guard ciphertext.count > 0, ciphertext.count % blockSize == 0 else { throw DecodeError("RSA ciphertext 长度无效") }
+		var output = Data()
+		for offset in stride(from: 0, to: ciphertext.count, by: blockSize) {
+			var error: Unmanaged<CFError>?
+			let block = ciphertext.subdata(in: offset..<(offset + blockSize))
+			guard let plain = SecKeyCreateDecryptedData(key, .rsaEncryptionPKCS1, block as CFData, &error) as Data? else { throw DecodeError("RSA PKCS#1 v1.5 解密失败") }
+			output.append(plain)
+		}
+		return output
+	}
+
+	private static func privateKeyDER(_ pem: String) throws -> Data {
+		let body = pem.components(separatedBy: .newlines).map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }.filter { !$0.isEmpty && !$0.hasPrefix("-----") }.joined()
+		guard let der = Data(base64Encoded: body, options: [.ignoreUnknownCharacters]) else { throw DecodeError("RSA PEM Base64 无效") }
+		if pem.contains("BEGIN RSA PRIVATE KEY") { return der }
+		guard pem.contains("BEGIN PRIVATE KEY") else { throw DecodeError("不支持的 RSA PEM 格式") }
+		var outer = DERReader(data: der), sequence = try outer.read(tag: 0x30), inner = DERReader(data: sequence)
+		_ = try inner.read(tag: 0x02); _ = try inner.read(tag: 0x30); return try inner.read(tag: 0x04)
+	}
+
+	private struct DERReader {
+		let data: Data; var index = 0
+		mutating func read(tag: UInt8) throws -> Data {
+			guard index < data.count, data[index] == tag else { throw DecodeError("DER tag 无效") }; index += 1
+			let length = try readLength(); guard index + length <= data.count else { throw DecodeError("DER 长度越界") }
+			let value = data.subdata(in: index..<(index + length)); index += length; return value
+		}
+		mutating func readLength() throws -> Int {
+			guard index < data.count else { throw DecodeError("DER length 缺失") }; let first = data[index]; index += 1
+			if first & 0x80 == 0 { return Int(first) }
+			let count = Int(first & 0x7f); guard count > 0, count <= 8, index + count <= data.count else { throw DecodeError("DER length 无效") }
+			var length = 0; for _ in 0..<count { length = (length << 8) | Int(data[index]); index += 1 }; return length
+		}
+	}
+
+	private struct DecodeError: LocalizedError { let message: String; init(_ message: String) { self.message = message }; var errorDescription: String? { message } }
+}
