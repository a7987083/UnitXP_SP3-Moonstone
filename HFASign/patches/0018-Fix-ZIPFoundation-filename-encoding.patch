From: Codex <codex@local.invalid>
Date: Fri, 4 Sep 2026 10:15:46 -0400
Subject: [PATCH] Resolve Unicode and legacy encoded ZIP entry paths

---
 Sources/ZIPFoundation/Entry.swift | 46 +++++++++++++++++++++++++++++++
 1 file changed, 46 insertions(+)

diff --git a/Sources/ZIPFoundation/Entry.swift b/Sources/ZIPFoundation/Entry.swift
index 300ab80..3ebaab6 100644
--- a/Sources/ZIPFoundation/Entry.swift
+++ b/Sources/ZIPFoundation/Entry.swift
@@ -117,6 +117,52 @@ public struct Entry: Equatable {
     public func path(using encoding: String.Encoding) -> String {
         return String(data: self.centralDirectoryStructure.fileNameData, encoding: encoding) ?? ""
     }
+    /// Returns a single, stable path for archives produced by UTF-8 and legacy
+    /// Chinese ZIP writers. Info-ZIP's Unicode Path field (0x7075) is accepted
+    /// only when its CRC matches the raw central-directory file name.
+    public func resolvedPath(legacyEncoding: String.Encoding) -> String {
+        let rawPath = self.centralDirectoryStructure.fileNameData
+        if let unicodePath = self.infoZIPUnicodePath(rawPath: rawPath) {
+            return unicodePath
+        }
+        if self.centralDirectoryStructure.usesUTF8PathEncoding {
+            return String(data: rawPath, encoding: .utf8) ?? self.path
+        }
+        // A number of ZIP writers emit UTF-8 without setting general purpose bit 11.
+        if let utf8Path = String(data: rawPath, encoding: .utf8) {
+            return utf8Path
+        }
+        if let legacyPath = String(data: rawPath, encoding: legacyEncoding) {
+            return legacyPath
+        }
+        return self.path
+    }
+
+    private func infoZIPUnicodePath(rawPath: Data) -> String? {
+        let bytes = [UInt8](self.centralDirectoryStructure.extraFieldData)
+        var offset = 0
+        while offset + 4 <= bytes.count {
+            let headerID = UInt16(bytes[offset]) | (UInt16(bytes[offset + 1]) << 8)
+            let payloadSize = Int(UInt16(bytes[offset + 2]) | (UInt16(bytes[offset + 3]) << 8))
+            let payloadStart = offset + 4
+            let payloadEnd = payloadStart + payloadSize
+            guard payloadEnd <= bytes.count else { return nil }
+            if headerID == 0x7075, payloadSize >= 5, bytes[payloadStart] == 1 {
+                let storedCRC = UInt32(bytes[payloadStart + 1])
+                    | (UInt32(bytes[payloadStart + 2]) << 8)
+                    | (UInt32(bytes[payloadStart + 3]) << 16)
+                    | (UInt32(bytes[payloadStart + 4]) << 24)
+                let unicodeData = Data(bytes[(payloadStart + 5)..<payloadEnd])
+                if storedCRC == rawPath.crc32(checksum: 0),
+                   let unicodePath = String(data: unicodeData, encoding: .utf8),
+                   !unicodePath.isEmpty {
+                    return unicodePath
+                }
+            }
+            offset = payloadEnd
+        }
+        return nil
+    }
     /// The `path` of the receiver within a ZIP `Archive`.
     public var path: String {
         let dosLatinUS = 0x400
