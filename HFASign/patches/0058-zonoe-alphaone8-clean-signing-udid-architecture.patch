@@ -0,0 +1,27 @@
+import Foundation
+
+struct ZonoeUDIDCallbackRequest: Equatable {
+    let enabled: Bool
+    let customBundleIdentifier: String?
+    let plistBundleIdentifier: String?
+}
+
+struct ZonoeUDIDCallbackConfiguration: Equatable {
+    let scheme: String
+    let host: String
+
+    var callbackURLString: String {
+        "\(scheme)://\(host)"
+    }
+}
+
+enum ZonoeUDIDCallbackMetadata {
+    static let marker = "zonoe.udid.callback"
+    static let schemeKey = "ZonoeUDIDCallbackScheme"
+    static let hostKey = "ZonoeUDIDCallbackHost"
+    static let host = "udid-callback"
+}
+
+protocol ZonoeUDIDCallbackSchemeGenerating {
+    func makeScheme(bundleIdentifier: String, date: Date, nonce: String) -> String
+}
diff --git a/Ksign/Features/Signing/Application/ConfigureZonoeUDIDCallbackUseCase.swift b/Ksign/Features/Signing/Application/ConfigureZonoeUDIDCallbackUseCase.swift
new file mode 100644
--- /dev/null
+++ b/Ksign/Features/Signing/Application/ConfigureZonoeUDIDCallbackUseCase.swift
@@ -0,0 +1,38 @@
+import Foundation
+
+struct ConfigureZonoeUDIDCallbackUseCase {
+    private let generator: ZonoeUDIDCallbackSchemeGenerating
+    private let now: () -> Date
+    private let nonce: () -> String
+
+    init(
+        generator: ZonoeUDIDCallbackSchemeGenerating,
+        now: @escaping () -> Date = Date.init,
+        nonce: @escaping () -> String = { UUID().uuidString }
+    ) {
+        self.generator = generator
+        self.now = now
+        self.nonce = nonce
+    }
+
+    func execute(_ request: ZonoeUDIDCallbackRequest) -> ZonoeUDIDCallbackConfiguration? {
+        guard request.enabled else { return nil }
+
+        let customID = request.customBundleIdentifier?.trimmingCharacters(in: .whitespacesAndNewlines)
+        let bundleIdentifier: String
+        if let customID, !customID.isEmpty {
+            bundleIdentifier = customID
+        } else {
+            bundleIdentifier = request.plistBundleIdentifier ?? "unknown"
+        }
+
+        return ZonoeUDIDCallbackConfiguration(
+            scheme: generator.makeScheme(
+                bundleIdentifier: bundleIdentifier,
+                date: now(),
+                nonce: nonce()
+            ),
+            host: ZonoeUDIDCallbackMetadata.host
+        )
+    }
+}
diff --git a/Ksign/Features/Signing/Infrastructure/ZonoeUDIDCallbackInfrastructure.swift b/Ksign/Features/Signing/Infrastructure/ZonoeUDIDCallbackInfrastructure.swift
new file mode 100644
--- /dev/null
+++ b/Ksign/Features/Signing/Infrastructure/ZonoeUDIDCallbackInfrastructure.swift
@@ -0,0 +1,56 @@
+import Foundation
+
+struct DefaultZonoeUDIDCallbackSchemeGenerator: ZonoeUDIDCallbackSchemeGenerating {
+    func makeScheme(bundleIdentifier: String, date: Date, nonce: String) -> String {
+        let allowed = CharacterSet(charactersIn: "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789+.-")
+        let sanitized = bundleIdentifier.unicodeScalars
+            .map { allowed.contains($0) ? String($0) : "-" }
+            .joined()
+            .trimmingCharacters(in: CharacterSet(charactersIn: "-"))
+            .lowercased()
+
+        let formatter = DateFormatter()
+        formatter.locale = Locale(identifier: "en_US_POSIX")
+        formatter.calendar = Calendar(identifier: .gregorian)
+        formatter.dateFormat = "yyyyMMddHHmm"
+
+        let cleanNonce = nonce.replacingOccurrences(of: "-", with: "").lowercased()
+        let identifier = sanitized.isEmpty ? "unknown" : sanitized
+        return "zonoe-\(identifier)-\(formatter.string(from: date))-\(cleanNonce)"
+    }
+}
+
+struct ZonoeUDIDCallbackPlistAdapter {
+    func apply(_ configuration: ZonoeUDIDCallbackConfiguration?, to infoDictionary: NSMutableDictionary) {
+        let previousScheme = infoDictionary[ZonoeUDIDCallbackMetadata.schemeKey] as? String
+        var urlTypes = (infoDictionary["CFBundleURLTypes"] as? [[String: Any]]) ?? []
+
+        urlTypes.removeAll { type in
+            if (type["CFBundleURLName"] as? String) == ZonoeUDIDCallbackMetadata.marker {
+                return true
+            }
+            guard let previousScheme else { return false }
+            return (type["CFBundleURLSchemes"] as? [String])?.contains(previousScheme) == true
+        }
+
+        infoDictionary.removeObject(forKey: ZonoeUDIDCallbackMetadata.schemeKey)
+        infoDictionary.removeObject(forKey: ZonoeUDIDCallbackMetadata.hostKey)
+
+        guard let configuration else {
+            if urlTypes.isEmpty {
+                infoDictionary.removeObject(forKey: "CFBundleURLTypes")
+            } else {
+                infoDictionary["CFBundleURLTypes"] = urlTypes
+            }
+            return
+        }
+
+        urlTypes.append([
+            "CFBundleURLName": ZonoeUDIDCallbackMetadata.marker,
+            "CFBundleURLSchemes": [configuration.scheme]
+        ])
+        infoDictionary["CFBundleURLTypes"] = urlTypes
+        infoDictionary[ZonoeUDIDCallbackMetadata.schemeKey] = configuration.scheme
+        infoDictionary[ZonoeUDIDCallbackMetadata.hostKey] = configuration.host
+    }
+}
