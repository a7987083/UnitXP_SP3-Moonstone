+struct ZonoeUDIDCallbackSection: View {
+    @Binding var isEnabled: Bool?
+
+    var body: some View {
+        NBSection("zonoe") {
+            Toggle("注册 zonoe UDID 回调", isOn: Binding(
+                get: { isEnabled == true },
+                set: { isEnabled = $0 }
+            ))
+        } footer: {
+            Text("签名时生成唯一 URL Scheme，供注入的 dylib 通过 zonoe://udid 获取并接收本机 UDID。")
+        }
+    }
+}
