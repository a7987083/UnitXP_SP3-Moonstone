diff --git a/Ksign/Utilities/SharedImportCoordinator.swift b/Ksign/Utilities/SharedImportCoordinator.swift
new file mode 100644
index 0000000..195302d
--- /dev/null
+++ b/Ksign/Utilities/SharedImportCoordinator.swift
@@ -0,0 +1,118 @@
+import Foundation
+import UIKit
+
+final class SharedImportCoordinator {
+    static let shared = SharedImportCoordinator()
+    private let fileManager = FileManager.default
+    private let progress = OperationProgressManager.shared
+
+    private init() {}
+
+    func receive(_ url: URL) {
+        let accessed = url.startAccessingSecurityScopedResource()
+
+        let ext = url.pathExtension.lowercased()
+        if ext == "ipa" || ext == "tipa" {
+            progress.begin("正在导入 IPA", detail: url.lastPathComponent)
+            let id = "HFASignImport_\(UUID().uuidString)"
+            let download = DownloadManager.shared.startArchive(from: url, id: id)
+            DownloadManager.shared.handlePachageFile(url: url, dl: download) { error in
+                if accessed { url.stopAccessingSecurityScopedResource() }
+                if let error {
+                    self.progress.fail("导入失败：\(error.localizedDescription)")
+                } else {
+                    self.progress.finish(detail: "导入完成")
+                }
+            }
+            return
+        }
+
+        let supported = ["zip", "dylib", "framework", "deb", "p12", "mobileprovision"]
+        guard supported.contains(ext) || url.hasDirectoryPath else {
+            if accessed { url.stopAccessingSecurityScopedResource() }
+            progress.fail("暂不支持此文件类型")
+            return
+        }
+
+        let imports = URL.documentsDirectory.appendingPathComponent("Imports", isDirectory: true)
+        try? fileManager.createDirectory(at: imports, withIntermediateDirectories: true)
+        let destination = imports.appendingPathComponent(url.lastPathComponent)
+        resolveConflict(for: destination) { choice in
+            guard let choice else {
+                if accessed { url.stopAccessingSecurityScopedResource() }
+                return
+            }
+            self.copy(url, to: choice) {
+                if accessed { url.stopAccessingSecurityScopedResource() }
+            }
+        }
+    }
+
+    private func resolveConflict(for destination: URL, completion: @escaping (URL?) -> Void) {
+        guard fileManager.fileExists(atPath: destination.path) else {
+            completion(destination)
+            return
+        }
+        DispatchQueue.main.async {
+            let overwrite = UIAlertAction(title: "覆盖", style: .destructive) { _ in
+                try? self.fileManager.removeItem(at: destination)
+                completion(destination)
+            }
+            let keepBoth = UIAlertAction(title: "保留两个", style: .default) { _ in
+                completion(self.uniqueURL(for: destination))
+            }
+            UIAlertController.showAlertWithCancel(
+                title: "文件已存在",
+                message: "“\(destination.lastPathComponent)”已存在，是否覆盖？",
+                actions: [overwrite, keepBoth]
+            )
+        }
+    }
+
+    private func copy(_ source: URL, to destination: URL, completion: @escaping () -> Void) {
+        progress.begin("正在导入文件", detail: source.lastPathComponent)
+        DispatchQueue.global(qos: .userInitiated).async {
+            do {
+                if source.hasDirectoryPath {
+                    try self.fileManager.copyItem(at: source, to: destination)
+                } else {
+                    try self.copyFileWithProgress(source, to: destination)
+                }
+                self.progress.finish(detail: "已保存到文件区 / Imports")
+            } catch {
+                self.progress.fail("导入失败：\(error.localizedDescription)")
+            }
+            completion()
+        }
+    }
+
+    private func copyFileWithProgress(_ source: URL, to destination: URL) throws {
+        fileManager.createFile(atPath: destination.path, contents: nil)
+        let input = try FileHandle(forReadingFrom: source)
+        let output = try FileHandle(forWritingTo: destination)
+        defer { try? input.close(); try? output.close() }
+        let size = (try? source.resourceValues(forKeys: [.fileSizeKey]).fileSize) ?? 0
+        var copied = 0
+        while true {
+            let data = try input.read(upToCount: 1024 * 1024) ?? Data()
+            if data.isEmpty { break }
+            try output.write(contentsOf: data)
+            copied += data.count
+            let fraction = size > 0 ? Double(copied) / Double(size) : 0.5
+            progress.update(fraction, detail: "正在复制 \(source.lastPathComponent)")
+        }
+    }
+
+    private func uniqueURL(for url: URL) -> URL {
+        var index = 1
+        var candidate = url
+        while fileManager.fileExists(atPath: candidate.path) {
+            let base = url.deletingPathExtension().lastPathComponent
+            let ext = url.pathExtension
+            let name = ext.isEmpty ? "\(base) (\(index))" : "\(base) (\(index)).\(ext)"
+            candidate = url.deletingLastPathComponent().appendingPathComponent(name)
+            index += 1
+        }
+        return candidate
+    }
+}
diff --git a/Ksign/Views/Common/OperationProgressView.swift b/Ksign/Views/Common/OperationProgressView.swift
new file mode 100644
index 0000000..c0795fa
--- /dev/null
+++ b/Ksign/Views/Common/OperationProgressView.swift
@@ -0,0 +1,24 @@
+import SwiftUI
+
+struct OperationProgressView: View {
+    @ObservedObject var manager: OperationProgressManager
+
+    var body: some View {
+        if manager.isActive {
+            VStack(alignment: .leading, spacing: 5) {
+                HStack {
+                    Text(manager.title).font(.subheadline.bold())
+                    Spacer()
+                    Text("\(Int(manager.progress * 100))%")
+                        .font(.caption.monospacedDigit())
+                        .foregroundStyle(.secondary)
+                }
+                ProgressView(value: manager.progress)
+                Text(manager.detail).font(.caption).foregroundStyle(.secondary)
+            }
+            .padding(.horizontal)
+            .padding(.vertical, 8)
+            .background(.regularMaterial)
+        }
+    }
+}
