new file mode 100644
index 0000000..acb1b8e
--- /dev/null
+++ b/Ksign/Backend/Observable/OperationProgressManager.swift
@@ -0,0 +1,47 @@
+import Foundation
+
+final class OperationProgressManager: ObservableObject {
+    static let shared = OperationProgressManager()
+
+    @Published var isActive = false
+    @Published var title = ""
+    @Published var detail = ""
+    @Published var progress: Double = 0
+
+    private init() {}
+
+    func begin(_ title: String, detail: String = "") {
+        DispatchQueue.main.async {
+            self.title = title
+            self.detail = detail
+            self.progress = 0
+            self.isActive = true
+        }
+    }
+
+    func update(_ progress: Double, detail: String) {
+        DispatchQueue.main.async {
+            self.progress = min(max(progress, 0), 1)
+            self.detail = detail
+        }
+    }
+
+    func finish(detail: String = "") {
+        DispatchQueue.main.async {
+            self.progress = 1
+            self.detail = detail
+            DispatchQueue.main.asyncAfter(deadline: .now() + 0.7) {
+                self.isActive = false
+            }
+        }
+    }
+
+    func fail(_ message: String) {
+        DispatchQueue.main.async {
+            self.detail = message
+            DispatchQueue.main.asyncAfter(deadline: .now() + 1.5) {
+                self.isActive = false
+            }
+        }
+    }
+}
