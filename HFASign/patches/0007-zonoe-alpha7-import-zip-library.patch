+private struct ZipContentsView: View {
+	@Environment(\.dismiss) private var dismiss
+	let archiveURL: URL
+	@State private var extractionRoot: URL?
+	@State private var files: [URL] = []
+	@State private var importCandidate: URL?
+	@State private var errorMessage: String?
+
+	var body: some View {
+		NavigationStack {
+			List {
+				if files.isEmpty && errorMessage == nil {
+					HStack { Spacer(); ProgressView("正在读取压缩包…"); Spacer() }
+				} else {
+					ForEach(files, id: \.self) { file in
+						Button { handle(file) } label: {
+							HStack(spacing: 12) {
+								Image(systemName: icon(for: file)).foregroundStyle(.secondary)
+								VStack(alignment: .leading, spacing: 3) {
+									Text(relativePath(file)).foregroundStyle(.primary).lineLimit(2)
+									if isImportable(file) { Text("可导入动态库").font(.caption).foregroundStyle(.blue) }
+								}
+								Spacer()
+								if isImportable(file) { Image(systemName: "square.and.arrow.down") }
+							}
+						}
+						.disabled(file.hasDirectoryPath && !isImportable(file))
+					}
+				}
+			}
+			.navigationTitle(archiveURL.lastPathComponent)
+			.navigationBarTitleDisplayMode(.inline)
+			.toolbar { ToolbarItem(placement: .topBarLeading) { Button { dismiss() } label: { Label("返回", systemImage: "chevron.left") } } }
+			.alert("导入动态库", isPresented: Binding(get: { importCandidate != nil }, set: { if !$0 { importCandidate = nil } })) {
+				Button("取消", role: .cancel) { importCandidate = nil }
+				Button("导入") {
+					if let file = importCandidate { SharedImportCoordinator.shared.receive(file) }
+					importCandidate = nil
+				}
+			} message: { Text("是否导入“\(importCandidate?.lastPathComponent ?? "")”？") }
+			.alert("读取失败", isPresented: Binding(get: { errorMessage != nil }, set: { if !$0 { errorMessage = nil } })) {
+				Button("确定", role: .cancel) {}
+			} message: { Text(errorMessage ?? "未知错误") }
+			.task { extract() }
+			.onDisappear { if let extractionRoot { try? FileManager.default.removeItem(at: extractionRoot) } }
+		}
+	}
+
+	private func extract() {
+		let root = FileManager.default.temporaryDirectory.appendingPathComponent("zonoe-zip-preview/\(UUID().uuidString)", isDirectory: true)
+		do {
+			try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)
+			let archive = try ZIPFoundation.Archive(url: archiveURL, accessMode: .read)
+			for entry in archive {
+				let output = root.appendingPathComponent(entry.path)
+				guard output.standardizedFileURL.path.hasPrefix(root.standardizedFileURL.path + "/") else { continue }
+				try FileManager.default.createDirectory(at: output.deletingLastPathComponent(), withIntermediateDirectories: true)
+				_ = try archive.extract(entry, to: output)
+			}
+			let items = (FileManager.default.enumerator(at: root, includingPropertiesForKeys: [.isDirectoryKey], options: [.skipsHiddenFiles])?.allObjects as? [URL]) ?? []
+			DispatchQueue.main.async { extractionRoot = root; files = items.sorted { relativePath($0) < relativePath($1) } }
+		} catch {
+			try? FileManager.default.removeItem(at: root)
+			DispatchQueue.main.async { errorMessage = error.localizedDescription }
+		}
+	}
+
+	private func relativePath(_ file: URL) -> String {
+		guard let extractionRoot else { return file.lastPathComponent }
+		return String(file.path.dropFirst(extractionRoot.path.count + 1))
+	}
+	private func isImportable(_ file: URL) -> Bool { ["dylib", "framework", "deb", "bundle"].contains(file.pathExtension.lowercased()) }
+	private func handle(_ file: URL) { if isImportable(file) { importCandidate = file } }
+	private func icon(for file: URL) -> String {
+		if file.hasDirectoryPath { return "folder.fill" }
+		return isImportable(file) ? "shippingbox.fill" : "doc.fill"
+	}
+}
