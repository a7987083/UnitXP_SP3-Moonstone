+	func prepareBridgeResult(udid: String, nonce: String, completion: @escaping (Bool) -> Void) {
+		guard isValidBridgeNonce(nonce), !udid.isEmpty else {
+			completion(false)
+			return
+		}
+
+		start { result in
+			switch result {
+			case .success:
+				self.bridgeLock.lock()
+				let now = Date()
+				self.bridgeResults = self.bridgeResults.filter { $0.value.expiresAt > now }
+				self.bridgeResults[nonce] = BridgeResult(udid: udid, expiresAt: now.addingTimeInterval(90))
+				self.bridgeLock.unlock()
+				completion(true)
+			case .failure:
+				completion(false)
+			}
+		}
+	}
+
+	private func consumeBridgeResult(for nonce: String) -> BridgeResult? {
+		guard isValidBridgeNonce(nonce) else { return nil }
+		bridgeLock.lock()
+		defer { bridgeLock.unlock() }
+
+		guard let result = bridgeResults.removeValue(forKey: nonce), result.expiresAt > Date() else {
+			return nil
+		}
+		return result
+	}
+
+	private func isValidBridgeNonce(_ value: String) -> Bool {
+		guard (16...128).contains(value.count) else { return false }
+		let allowed = CharacterSet.alphanumerics.union(CharacterSet(charactersIn: "-_"))
+		return value.unicodeScalars.allSatisfy { allowed.contains($0) }
+	}
