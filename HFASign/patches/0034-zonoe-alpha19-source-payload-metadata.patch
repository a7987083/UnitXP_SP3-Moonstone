+	func appMetadata(for sourceURL: URL, appIdentifier: String?, appName: String) -> SourceAppMetadata? {
+		let sourceKey = SourceURLIdentity.normalized(sourceURL).absoluteString
+		metadataLock.lock(); defer { metadataLock.unlock() }
+		guard let apps = appMetadataBySource[sourceKey] else { return nil }
+		if let appIdentifier, !appIdentifier.isEmpty, let value = apps["id:\(appIdentifier)"] { return value }
+		return apps["name:\(appName)"]
+	}
+
+	func discoveredFieldKeys(for sourceURLs: [URL]) -> [String] {
+		metadataLock.lock(); defer { metadataLock.unlock() }
+		let keys = sourceURLs.flatMap { appMetadataBySource[SourceURLIdentity.normalized($0).absoluteString]?.values ?? [] }
+			.flatMap { $0.rawFields.keys }
+		return Array(Set(keys)).sorted { $0.localizedCaseInsensitiveCompare($1) == .orderedAscending }
+	}
+
 	private func decode(_ data: Data, sourceURL: URL) throws -> ASRepository {
 		let decoder = JSONDecoder()
 		let object: Any
 		do { object = try JSONSerialization.jsonObject(with: data) }
 		catch { throw LoaderError.invalidJSON(error.localizedDescription) }
