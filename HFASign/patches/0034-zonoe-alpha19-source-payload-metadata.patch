+	private func makeExtendedMetadata(_ app: [String: Any], sourceName: String?) -> SourceAppMetadata {
+		let text: (String...) -> String? = { keys in
+			for key in keys { if let value = app[key] as? String, !value.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty { return value } }
+			return nil
+		}
+		let version = text("version", "versionCode")
+		let sizeValue = app["size"] as? NSNumber ?? (text("size").flatMap(Double.init).map(NSNumber.init(value:)))
+		let priceValue = app["price"] as? NSNumber ?? (text("price").flatMap(Double.init).map(NSNumber.init(value:)))
+		let date = text("versionDate", "updatedAt", "date").flatMap(parseSourceDate)
+		return SourceAppMetadata(
+			rawFields: app.mapValues(SourceJSONValue.init(any:)), sourceName: sourceName, version: version,
+			size: sizeValue.map { Int64($0.doubleValue) }, updatedAt: date,
+			description: text("localizedDescription", "description", "desc"),
+			releaseNotes: text("versionDescription", "releaseNotes"), category: text("category", "type"),
+			price: priceValue?.doubleValue, developer: text("developer", "author", "sellerName"),
+			minimumOSVersion: text("minimumOSVersion", "minOSVersion", "support")
+		)
+	}
+
+	private func parseSourceDate(_ value: String) -> Date? {
+		let iso = ISO8601DateFormatter()
+		if let date = iso.date(from: value) { return date }
+		for format in ["yyyy-MM-dd HH:mm:ss", "yyyy-MM-dd", "yyyy/MM/dd"] {
+			let formatter = DateFormatter(); formatter.locale = Locale(identifier: "en_US_POSIX"); formatter.dateFormat = format
+			if let date = formatter.date(from: value) { return date }
+		}
+		return nil
+	}
+
 	private func boolValue(_ value: Any?) -> Bool? {
 		if let value = value as? Bool { return value }
 		if let value = value as? NSNumber { return value.intValue != 0 }
