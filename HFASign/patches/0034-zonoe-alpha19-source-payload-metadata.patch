+enum SourceJSONValue: Codable, Hashable {
+	case string(String), number(Double), bool(Bool), array([SourceJSONValue]), object([String: SourceJSONValue]), null
+
+	init(any value: Any) {
+		switch value {
+		case let value as String: self = .string(value)
+		case let value as Bool: self = .bool(value)
+		case let value as NSNumber: self = .number(value.doubleValue)
+		case let value as [Any]: self = .array(value.map(SourceJSONValue.init(any:)))
+		case let value as [String: Any]: self = .object(value.mapValues(SourceJSONValue.init(any:)))
+		default: self = .null
+		}
+	}
+
+	var displayText: String? {
+		switch self {
+		case .string(let value): return value.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty ? nil : value
+		case .number(let value): return value.rounded() == value ? String(Int64(value)) : String(value)
+		case .bool(let value): return value ? "是" : "否"
+		case .array(let values):
+			let strings = values.compactMap { value -> String? in if case .string(let text) = value { return text }; return nil }
+			return strings.count == values.count ? strings.joined(separator: "、") : nil
+		case .object, .null: return nil
+		}
+	}
+}
+
+struct SourceAppMetadata: Equatable {
+	let rawFields: [String: SourceJSONValue]
+	let sourceName: String?
+	let version: String?
+	let size: Int64?
+	let updatedAt: Date?
+	let description: String?
+	let releaseNotes: String?
+	let category: String?
+	let price: Double?
+	let developer: String?
+	let minimumOSVersion: String?
+}
