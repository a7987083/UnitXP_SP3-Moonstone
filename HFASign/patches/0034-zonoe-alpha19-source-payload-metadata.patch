+		if let wrapper = object as? [String: Any], let encrypted = wrapper["appstore_v2"] as? String {
+			return try decodeEncrypted(encrypted, version: 2, decoder: decoder, sourceURL: sourceURL)
 		}
 		captureMetadata(object, for: sourceURL)
-		let normalized = try JSONSerialization.data(withJSONObject: normalizeURLs(repositoryObject(from: object)))
+		let normalized = try JSONSerialization.data(withJSONObject: normalizeRepository(repositoryObject(from: object)))
