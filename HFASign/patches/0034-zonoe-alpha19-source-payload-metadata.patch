 			.replacingOccurrences(of: "-", with: "+")
 			.replacingOccurrences(of: "_", with: "/")
 		while compact.count % 4 != 0 { compact.append("=") }
-		guard let cipher = Data(base64Encoded: compact, options: [.ignoreUnknownCharacters]) else {
+		guard version == 1, let cipher = Data(base64Encoded: compact, options: [.ignoreUnknownCharacters]) else {
 			throw LoaderError.invalidEncryptedPayload
 		}
 		let plain = try decryptDES(cipher)
