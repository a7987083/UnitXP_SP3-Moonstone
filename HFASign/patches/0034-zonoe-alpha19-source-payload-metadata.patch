+	private func normalizeRepository(_ object: Any) -> Any {
+		guard var root = normalizeURLs(object) as? [String: Any] else { return normalizeURLs(object) }
+		if root["iconURL"] == nil, let sourceIcon = root["sourceicon"] { root["iconURL"] = sourceIcon }
+		if let apps = root["apps"] as? [[String: Any]] {
+			root["apps"] = apps.map { app in
+				var app = app
+				if app["bundleIdentifier"] == nil { app["bundleIdentifier"] = app["identifier"] ?? "zonoe.source.\(UUID().uuidString)" }
+				if app["localizedDescription"] == nil { app["localizedDescription"] = app["description"] ?? app["versionDescription"] }
+				if let size = app["size"] as? String, let value = Double(size) { app["size"] = Int64(value) }
+				return app
+			}
+		}
+		return root
+	}
+
