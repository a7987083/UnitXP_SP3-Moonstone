+	private func safeArchiveRelativePath(_ raw: String) -> String? {
+		guard !raw.isEmpty, !raw.contains("\0") else { return nil }
+		let slashPath = raw.replacingOccurrences(of: "\\", with: "/")
+		let lowercased = slashPath.lowercased()
+		guard !slashPath.hasPrefix("/"), !slashPath.hasPrefix("//"), !lowercased.hasPrefix("file://") else { return nil }
+		if slashPath.range(of: "^[A-Za-z]:($|/)", options: .regularExpression) != nil { return nil }
+
+		var components: [String] = []
+		for component in slashPath.split(separator: "/", omittingEmptySubsequences: true).map(String.init) {
+			switch component {
+			case ".": continue
+			case "..":
+				guard !components.isEmpty else { return nil }
+				components.removeLast()
+			default: components.append(component)
+			}
+		}
+		guard !components.isEmpty else { return nil }
+		return components.joined(separator: "/")
+	}
+
+	private func looselyNormalizedArchivePath(_ raw: String) -> String {
+		var path = raw.replacingOccurrences(of: "\\", with: "/")
+		while path.hasPrefix("./") { path.removeFirst(2) }
+		while path.contains("//") { path = path.replacingOccurrences(of: "//", with: "/") }
+		return path
+	}
+
+	private func safeOutputURL(for relativePath: String, root: URL) throws -> URL {
+		guard let normalizedPath = safeArchiveRelativePath(relativePath) else { throw ZipPreviewError.unsafePath(relativePath) }
+		let standardizedRoot = root.standardizedFileURL
+		let output = standardizedRoot.appendingPathComponent(normalizedPath).standardizedFileURL
+		let rootBoundary = standardizedRoot.path.hasSuffix("/") ? standardizedRoot.path : standardizedRoot.path + "/"
+		guard output.path.hasPrefix(rootBoundary) else { throw ZipPreviewError.unsafePath(relativePath) }
 		return output
 	}
 
