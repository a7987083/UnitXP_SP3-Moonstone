@@ -92,12 +104,49 @@
-	private func consumeBridgeResult(for nonce: String) -> BridgeResult? {
+	private func bridgeResult(for nonce: String) -> BridgeResult? {
 		guard isValidBridgeNonce(nonce) else { return nil }
 		bridgeLock.lock()
 		defer { bridgeLock.unlock() }
 
-		guard let result = bridgeResults.removeValue(forKey: nonce), result.expiresAt > Date() else {
+		guard let result = bridgeResults[nonce] else { return nil }
+		guard result.expiresAt > Date() else {
+			bridgeResults.removeValue(forKey: nonce)
 			return nil
 		}
 		return result
 	}
+
+	private func acknowledgeBridgeResult(for nonce: String) -> Bool {
+		bridgeLock.lock()
+		defer { bridgeLock.unlock() }
+		return bridgeResults.removeValue(forKey: nonce) != nil
+	}
+
+	private func endBackgroundTaskIfIdle() {
+		bridgeLock.lock()
+		let isIdle = bridgeResults.isEmpty
+		bridgeLock.unlock()
+		if isIdle { endBackgroundTask() }
+	}
+
+	private func firstAvailableBridgePort() -> Int? {
+		Self.bridgePorts.first(where: isPortAvailable)
+	}
+
+	private func isPortAvailable(_ port: Int) -> Bool {
+		let descriptor = Darwin.socket(AF_INET, SOCK_STREAM, 0)
+		guard descriptor >= 0 else { return false }
+		defer { Darwin.close(descriptor) }
+
+		var address = sockaddr_in()
+		address.sin_len = UInt8(MemoryLayout<sockaddr_in>.size)
+		address.sin_family = sa_family_t(AF_INET)
+		address.sin_port = in_port_t(port).bigEndian
+		address.sin_addr = in_addr(s_addr: Darwin.inet_addr("127.0.0.1"))
+
+		return withUnsafePointer(to: &address) { pointer in
+			pointer.withMemoryRebound(to: sockaddr.self, capacity: 1) {
+				Darwin.bind(descriptor, $0, socklen_t(MemoryLayout<sockaddr_in>.size)) == 0
+			}
+		}
+	}
