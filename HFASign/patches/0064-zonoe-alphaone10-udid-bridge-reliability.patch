 			app.post("udid") { req -> Response in
+			app.post("bridge", "ack", ":nonce") { req -> Response in
+				guard let nonce = req.parameters.get("nonce"), self.isValidBridgeNonce(nonce) else {
+					return Response(status: .badRequest, headers: ["Connection": "close"])
+				}
+				let acknowledged = self.acknowledgeBridgeResult(for: nonce)
+				if acknowledged { self.endBackgroundTaskIfIdle() }
