diff --git a/Ksign/FeatherApp.swift b/Ksign/FeatherApp.swift
index 14bb9d6..dbb6725 100644
--- a/Ksign/FeatherApp.swift
+++ b/Ksign/FeatherApp.swift
@@ -45,7 +45,7 @@ struct FeatherApp: App {
 	}
 	
 	private func _handleURL(_ url: URL) {
-		if url.scheme == "ksign" {
+		if url.scheme == "hfasign" {
 			if let fullPath = url.validatedScheme(after: "/source/") {
 				FR.handleSource(fullPath) { }
 			}
@@ -84,16 +84,9 @@ class AppDelegate: NSObject, UIApplicationDelegate {
         
         _createPipeline()
         _createSourcesDirectory()
-        if !UserDefaults.standard.bool(forKey: "hasInitializedBuiltInSources") {
-            _initializeBuiltInSources()
-            UserDefaults.standard.set(true, forKey: "hasInitializedBuiltInSources")
-        }
-        
-        _clean()
+		_clean()
         
         _copyServerCertificates()
-        _addDefaultCertificates()
-
 #if SERVER
         // fallback just in case xd
         _downloadSSLCertificates()
@@ -114,7 +107,7 @@ class AppDelegate: NSObject, UIApplicationDelegate {
                 config.urlCache = nil
                 return DataLoader(configuration: config)
             }()
-            let dataCache = try? DataCache(name: "thewonderofyou.Feather.datacache") // disk cache
+            let dataCache = try? DataCache(name: "com.hfa.sign.datacache") // disk cache
             let imageCache = Nuke.ImageCache() // memory cache
             dataCache?.sizeLimit = 500 * 1024 * 1024
             imageCache.costLimit = 100 * 1024 * 1024
