@@ -114,6 +114,17 @@ struct DownloadButtonView: View {
 	}
 
 	private var isSourceLocked: Bool {
+		let udid = UserDefaults.standard.string(forKey: "zonoe.deviceUDID")?.trimmingCharacters(in: .whitespacesAndNewlines) ?? ""
+		if SourceRepositoryLoader.shared.accessMetadata(for: sourceURL)?.legacyKey != nil,
+		   !udid.isEmpty,
+		   SourceUnlockService.shared.hasLegacyGrant(
+			sourceURL: sourceURL,
+			appIdentifier: app.id,
+			appName: app.currentName,
+			udid: udid
+		   ) {
+			return false
+		}
 		if let access = SourceRepositoryLoader.shared.appAccessMetadata(
 			for: sourceURL,
 			appIdentifier: app.id,
